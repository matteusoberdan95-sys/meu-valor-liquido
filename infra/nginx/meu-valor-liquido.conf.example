# Exemplo de reverse proxy com TLS para o container webapp (porta 8080).
# Ajuste server_name, caminhos dos certificados e upstream conforme o host.

upstream meu_valor_liquido {
    server 127.0.0.1:8080;
    keepalive 32;
}

server {
    listen 80;
    server_name meuvalorliquido.com.br www.meuvalorliquido.com.br;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name meuvalorliquido.com.br www.meuvalorliquido.com.br;

    ssl_certificate     /etc/letsencrypt/live/meuvalorliquido.com.br/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/meuvalorliquido.com.br/privkey.pem;

    client_max_body_size 2m;

    location / {
        proxy_pass http://meu_valor_liquido;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
    }
}
