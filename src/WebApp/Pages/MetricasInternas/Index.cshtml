@page "/metricas-internas"
@model MeuValorLiquido.WebApp.Pages.MetricasInternas.IndexModel
@{
    ViewData["Title"] = "Métricas internas agregadas";
    var period7Active = Model.SelectedPeriodDays == ProductMetricsPeriod.Week;
    var period30Active = !period7Active;
}

@section Head {
    <partial name="Shared/_JsonLdBreadcrumb" model="SeoMetadataHelper.InternalMetricsBreadcrumbs()" />
}

<nav aria-label="breadcrumb">
    <ol class="valora-breadcrumb">
        <li><a asp-page="/Index">Início</a></li>
        <li><span class="material-symbols-outlined" style="font-size: 1rem;">chevron_right</span></li>
        <li class="active" aria-current="page">Métricas internas</li>
    </ol>
</nav>

<h1 class="valora-h1">Métricas internas</h1>
<p class="valora-lead">
    Contadores agregados por dia — sem IP, e-mail, valores de salário ou identificação de usuários.
</p>

<div class="valora-section" style="display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: center;">
    <span class="valora-text-muted valora-text-sm">Período:</span>
    <div class="valora-choice-group" role="group" aria-label="Período das métricas">
        <a class="valora-choice@(period7Active ? " valora-choice--active" : "")"
           asp-page="/MetricasInternas/Index"
           asp-route-days="@ProductMetricsPeriod.Week">7 dias</a>
        <a class="valora-choice@(period30Active ? " valora-choice--active" : "")"
           asp-page="/MetricasInternas/Index"
           asp-route-days="@ProductMetricsPeriod.Month">30 dias</a>
    </div>
    <span class="valora-text-muted valora-text-sm">
        @Model.Summary.From.ToString("dd/MM/yyyy") — @Model.Summary.To.ToString("dd/MM/yyyy") (UTC)
    </span>
</div>

<section class="valora-section valora-card-grid" style="grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));">
    <article class="valora-card">
        <p class="valora-text-muted valora-text-sm" style="margin: 0;">Cálculos</p>
        <p class="valora-h2" style="margin: 0.25rem 0 0;">@Model.Summary.TotalCalculations.ToString("N0")</p>
    </article>
    <article class="valora-card">
        <p class="valora-text-muted valora-text-sm" style="margin: 0;">PDFs</p>
        <p class="valora-h2" style="margin: 0.25rem 0 0;">@Model.Summary.TotalPdfDownloads.ToString("N0")</p>
        <p class="valora-text-muted valora-text-sm" style="margin: 0.35rem 0 0;">
            @ProductMetricsDisplayHelper.FormatRate(Model.Summary.PdfPerCalculationPercent) dos cálculos
        </p>
    </article>
    <article class="valora-card">
        <p class="valora-text-muted valora-text-sm" style="margin: 0;">Compartilhamentos</p>
        <p class="valora-h2" style="margin: 0.25rem 0 0;">@Model.Summary.TotalShareCopies.ToString("N0")</p>
        <p class="valora-text-muted valora-text-sm" style="margin: 0.35rem 0 0;">
            @ProductMetricsDisplayHelper.FormatRate(Model.Summary.SharePerCalculationPercent) dos cálculos
        </p>
    </article>
    <article class="valora-card">
        <p class="valora-text-muted valora-text-sm" style="margin: 0;">Salvos no painel</p>
        <p class="valora-h2" style="margin: 0.25rem 0 0;">@Model.Summary.TotalPanelSaves.ToString("N0")</p>
        <p class="valora-text-muted valora-text-sm" style="margin: 0.35rem 0 0;">
            @ProductMetricsDisplayHelper.FormatRate(Model.Summary.PanelSavePerCalculationPercent) dos cálculos
        </p>
    </article>
    <article class="valora-card">
        <p class="valora-text-muted valora-text-sm" style="margin: 0;">Views widget</p>
        <p class="valora-h2" style="margin: 0.25rem 0 0;">@Model.Summary.TotalWidgetViews.ToString("N0")</p>
    </article>
</section>

<section class="valora-section valora-card">
    <h2 class="valora-h2">Ranking — calculadoras mais usadas</h2>
    @if (Model.Summary.TopCalculations.Count == 0)
    {
        <p class="valora-text-muted valora-text-sm" style="margin: 0;">Ainda sem dados no período.</p>
    }
    else
    {
        <ol class="valora-related-tools-list" style="list-style: decimal; padding-left: 1.25rem;">
            @foreach (var row in Model.Summary.TopCalculations)
            {
                <li style="margin-bottom: 0.5rem;">
                    <span class="valora-related-tool-name">@Model.CalculatorLabel(row.Label)</span>
                    <span class="valora-related-tool-teaser">@row.Count.ToString("N0") cálculos · @row.Label</span>
                </li>
            }
        </ol>
    }
</section>

<div class="valora-section valora-card-grid" style="grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));">
    <section class="valora-card">
        <h2 class="valora-h2">PDFs mais baixados</h2>
        @if (Model.Summary.TopPdfDownloads.Count == 0)
        {
            <p class="valora-text-muted valora-text-sm" style="margin: 0;">Ainda sem downloads no período.</p>
        }
        else
        {
            <ul class="valora-related-tools-list">
                @foreach (var row in Model.Summary.TopPdfDownloads)
                {
                    <li>
                        <span class="valora-related-tool-name">@Model.CalculatorLabel(row.Label)</span>
                        <span class="valora-related-tool-teaser">@row.Count.ToString("N0") PDFs</span>
                    </li>
                }
            </ul>
        }
    </section>

    <section class="valora-card">
        <h2 class="valora-h2">Mais compartilhadas</h2>
        @if (Model.Summary.TopShareCopies.Count == 0)
        {
            <p class="valora-text-muted valora-text-sm" style="margin: 0;">Ainda sem compartilhamentos no período.</p>
        }
        else
        {
            <ul class="valora-related-tools-list">
                @foreach (var row in Model.Summary.TopShareCopies)
                {
                    <li>
                        <span class="valora-related-tool-name">@Model.CalculatorLabel(row.Label)</span>
                        <span class="valora-related-tool-teaser">@row.Count.ToString("N0") shares</span>
                    </li>
                }
            </ul>
        }
    </section>

    <section class="valora-card">
        <h2 class="valora-h2">Mais salvas no painel</h2>
        @if (Model.Summary.TopPanelSaves.Count == 0)
        {
            <p class="valora-text-muted valora-text-sm" style="margin: 0;">Ainda sem salvamentos no período.</p>
        }
        else
        {
            <ul class="valora-related-tools-list">
                @foreach (var row in Model.Summary.TopPanelSaves)
                {
                    <li>
                        <span class="valora-related-tool-name">@Model.CalculatorLabel(row.Label)</span>
                        <span class="valora-related-tool-teaser">@row.Count.ToString("N0") salvos</span>
                    </li>
                }
            </ul>
        }
    </section>
</div>

<div class="valora-disclaimer valora-section">
    <span class="material-symbols-outlined">shield</span>
    <p style="margin: 0;">
        Uso interno para priorizar produto e conteúdo (Sprints 57-58). Rotina semanal em
        <code>docs/METRICS_ROUTINE.md</code>. Não substitui Google Analytics nem Search Console.
    </p>
</div>
