@page
@model MeuValorLiquido.WebApp.Pages.ErrorModel
@{
    ViewData["Title"] = "Erro";
    ViewData["Description"] = "Ocorreu um erro ao processar sua solicitação.";
    ViewData["Robots"] = SeoMetadataHelper.NoIndexRobots;
}

<h1 class="valora-h1">Algo deu errado</h1>
<p class="valora-text-muted">Não foi possível concluir sua solicitação. Tente novamente ou volte para a página inicial.</p>

@if (Model.ShowRequestId)
{
    <p class="valora-text-sm valora-text-muted">
        <strong>ID da requisição:</strong> <code>@Model.RequestId</code>
    </p>
}

<a class="valora-btn valora-btn-primary" asp-page="/Index" style="margin-top: 1rem;">Voltar ao início</a>
