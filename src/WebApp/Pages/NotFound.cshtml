@page
@model MeuValorLiquido.WebApp.Pages.NotFoundModel
@{
    ViewData["Title"] = Model.IsNotFound ? "Página não encontrada" : "Erro";
    ViewData["Description"] = Model.Lead;
    ViewData["Robots"] = SeoMetadataHelper.NoIndexRobots;
}

<div class="valora-stitch-error">
    <div class="valora-stitch-error-inner">
        <span class="valora-stitch-error-badge">@Model.BadgeText</span>

        <h1 class="valora-stitch-error-title">
            @if (Model.IsNotFound)
            {
                <text>Ops, o seu cálculo <span class="valora-stitch-error-title-accent">saiu da rota.</span></text>
            }
            else
            {
                <text>Algo impediu <span class="valora-stitch-error-title-accent">esta página de carregar.</span></text>
            }
        </h1>

        <p class="valora-stitch-error-lead">@Model.Lead</p>

        <div class="valora-stitch-error-grid">
            <a class="valora-stitch-error-card" asp-page="/Index">
                <span class="valora-stitch-error-card-icon valora-stitch-error-card-icon--primary">
                    <span class="material-symbols-outlined" aria-hidden="true">home</span>
                </span>
                <h2>Página inicial</h2>
                <p>Volte para o início e recomece sua navegação financeira.</p>
                <span class="valora-stitch-error-card-link valora-stitch-error-card-link--primary">
                    Acessar início
                    <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
                </span>
            </a>

            <a class="valora-stitch-error-card" asp-page="/Calculadoras/Index">
                <span class="valora-stitch-error-card-icon valora-stitch-error-card-icon--tertiary">
                    <span class="material-symbols-outlined" aria-hidden="true">calculate</span>
                </span>
                <h2>Calculadoras</h2>
                <p>Vá direto para as ferramentas de salário, impostos e finanças.</p>
                <span class="valora-stitch-error-card-link valora-stitch-error-card-link--tertiary">
                    Ver ferramentas
                    <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
                </span>
            </a>

            <a class="valora-stitch-error-card" asp-page="/Duvidas/Index">
                <span class="valora-stitch-error-card-icon valora-stitch-error-card-icon--secondary">
                    <span class="material-symbols-outlined" aria-hidden="true">help</span>
                </span>
                <h2>Central de ajuda</h2>
                <p>Tire dúvidas ou reporte um problema técnico.</p>
                <span class="valora-stitch-error-card-link valora-stitch-error-card-link--secondary">
                    Obter suporte
                    <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
                </span>
            </a>
        </div>

        <div class="valora-stitch-error-footer-art" aria-hidden="true">
            <div class="valora-stitch-error-footer-icons">
                <span class="material-symbols-outlined valora-stitch-error-footer-bg">data_alert</span>
                <span class="material-symbols-outlined valora-stitch-error-footer-accent">electrical_services</span>
            </div>
            <p>Liquid Value Ecosystem • Connection Error @Model.DisplayStatusCode</p>
        </div>
    </div>
</div>
