@page "/como-calculamos"
@model MeuValorLiquido.WebApp.Pages.ComoCalculamosModel

@section Head {
    <partial name="Shared/_JsonLdBreadcrumb" model="SeoMetadataHelper.HowWeCalculateBreadcrumbs()" />
}

<div class="valora-stitch-metodologia">
    <section class="valora-stitch-metodologia-hero">
        <div class="valora-stitch-metodologia-hero-badge">
            <span class="material-symbols-outlined" aria-hidden="true">verified_user</span>
            Como calculamos
        </div>
        <h1 class="valora-stitch-metodologia-hero-title">Transparência e Metodologia</h1>
        <p class="valora-stitch-metodologia-hero-lead">
            Nossos cálculos baseiam-se na legislação brasileira vigente para @Model.TaxYear,
            com tabelas centralizadas em <code>BrTaxTables@(Model.TaxYear)</code> e testes automatizados.
        </p>
    </section>

    <section class="valora-stitch-metodologia-section">
        <h2 class="valora-stitch-metodologia-section-title">Lógica de cálculo</h2>
        <div class="valora-stitch-metodologia-regimes">
            <article class="valora-stitch-metodologia-regime valora-stitch-metodologia-regime--clt">
                <div class="valora-stitch-metodologia-regime-head">
                    <span class="material-symbols-outlined" aria-hidden="true">work</span>
                    <h3>Regime CLT</h3>
                </div>
                <ul>
                    <li>
                        <span class="material-symbols-outlined" aria-hidden="true">account_balance</span>
                        <span><strong>INSS:</strong> cálculo progressivo com base na tabela de @Model.TaxYear.</span>
                    </li>
                    <li>
                        <span class="material-symbols-outlined" aria-hidden="true">receipt_long</span>
                        <span><strong>IRRF:</strong> alíquotas progressivas após dedução de dependentes (R$ @MetodologiaTableHelper.FormatCurrency(Model.DependentDeduction)).</span>
                    </li>
                    <li>
                        <span class="material-symbols-outlined" aria-hidden="true">savings</span>
                        <span><strong>FGTS:</strong> 8% provisionado (não deduzido do líquido nas simulações CLT).</span>
                    </li>
                </ul>
            </article>
            <article class="valora-stitch-metodologia-regime valora-stitch-metodologia-regime--pj">
                <div class="valora-stitch-metodologia-regime-head">
                    <span class="material-symbols-outlined" aria-hidden="true">business</span>
                    <h3>Regime PJ / MEI</h3>
                </div>
                <ul>
                    <li>
                        <span class="material-symbols-outlined" aria-hidden="true">summarize</span>
                        <span><strong>Simples Nacional:</strong> alíquota editável (padrão 6%) — não modela anexo, fator R nem DAS real.</span>
                    </li>
                    <li>
                        <span class="material-symbols-outlined" aria-hidden="true">confirmation_number</span>
                        <span><strong>DAS-MEI:</strong> valor fixo mensal atualizado conforme regras vigentes.</span>
                    </li>
                    <li>
                        <span class="material-symbols-outlined" aria-hidden="true">account_balance_wallet</span>
                        <span><strong>Pró-labore:</strong> INSS de 11% fixo sobre o pró-labore (teto previdenciário @Model.TaxYear).</span>
                    </li>
                </ul>
            </article>
        </div>
    </section>

    <section class="valora-stitch-metodologia-section">
        <h2 class="valora-stitch-metodologia-section-title">Tabelas de @Model.TaxYear</h2>
        <p class="valora-stitch-metodologia-table-hint">Deslize lateralmente para ver todos os dados.</p>

        <div class="valora-stitch-metodologia-tables">
        <div class="valora-stitch-metodologia-table-card">
            <div class="valora-stitch-metodologia-table-head">IRRF mensal</div>
            <div class="valora-stitch-metodologia-table-scroll">
                <table>
                    <thead>
                        <tr>
                            <th>Base de cálculo (R$)</th>
                            <th>Alíquota</th>
                            <th>Dedução (R$)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var bracket in Model.IrrfBrackets)
                        {
                            <tr>
                                <td>@MetodologiaTableHelper.FormatIrrfBaseRange(bracket)</td>
                                <td>@MetodologiaTableHelper.FormatRate(bracket.Rate)</td>
                                <td>@MetodologiaTableHelper.FormatCurrency(bracket.Deduction)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="valora-stitch-metodologia-table-card">
            <div class="valora-stitch-metodologia-table-head">INSS progressivo</div>
            <div class="valora-stitch-metodologia-table-scroll">
                <table>
                    <thead>
                        <tr>
                            <th>Salário de contribuição (R$)</th>
                            <th>Alíquota</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < Model.InssBrackets.Length; i++)
                        {
                            var bracket = Model.InssBrackets[i];
                            <tr>
                                <td>@MetodologiaTableHelper.FormatInssSalaryRange(bracket, i)</td>
                                <td>@MetodologiaTableHelper.FormatRate(bracket.Rate)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        </div>

        <p class="valora-stitch-metodologia-sources">
            <strong>Fontes:</strong> Portaria Interministerial MPS/MF nº 13/@Model.TaxYear (INSS);
            redução legal do IRRF conforme Lei nº 15.270/2025.
            Salário mínimo @Model.TaxYear: R$ @MetodologiaTableHelper.FormatCurrency(Model.MinimumWage).
        </p>
    </section>

    <section class="valora-stitch-metodologia-section valora-stitch-metodologia-principles">
        <h2 class="valora-stitch-metodologia-section-title">Princípios e limitações</h2>
        <ul class="valora-stitch-metodologia-list">
            <li>Todas as calculadoras retornam <strong>estimativas</strong> com cenários simplificados.</li>
            <li>Valores digitados no formulário <strong>não são gravados no servidor</strong>.</li>
            <li>Não entram: convenções coletivas, benefícios não informados ou planejamento tributário PJ completo.</li>
            <li>Métricas internas são agregadas, sem IP, e-mail ou valores salariais.</li>
        </ul>
        <p class="valora-stitch-metodologia-update">
            Encontrou divergência? Use o <a asp-page="/Contato">contato</a> — sem enviar valores reais, se preferir privacidade.
        </p>
    </section>

    <div class="valora-disclaimer valora-stitch-metodologia-disclaimer">
        <span class="material-symbols-outlined" aria-hidden="true">gavel</span>
        <p style="margin: 0;">
            Isso não é consultoria profissional. Leia o <a asp-page="/AvisoLegal">aviso legal</a> e os <a asp-page="/TermosDeUso">termos de uso</a>.
        </p>
    </div>

    <p class="valora-stitch-metodologia-actions">
        <a class="valora-btn valora-btn-primary" asp-page="/Calculadoras/Index">Ver calculadoras</a>
    </p>
</div>
