@page "/salario-liquido/{valor:int}/{variant}"
@model MeuValorLiquido.WebApp.Pages.SalarioLiquido.FaixaVariantModel
@{
    ViewData["Title"] = Model.PageContent.Title;
    ViewData["Description"] = Model.PageContent.Description;
    ViewData["CanonicalPath"] = SalaryBandCatalog.SlugPath(Model.PageContent.GrossAmount, Model.PageContent.Dependents);
}

@section Head {
    <partial name="Shared/_JsonLdFaq" model="Model.FaqSchemaItems" />
    <partial name="Shared/_JsonLdBreadcrumb" model="SeoMetadataHelper.SalaryBandBreadcrumbs(Model.PageContent.GrossAmount, Model.PageContent.Dependents)" />
}

<partial name="SalarioLiquido/_FaixaContent" model="Model" />

@section Scripts {
    <script src="~/js/calculator-result-views.js" asp-append-version="true"></script>
    <script src="~/js/calculator-share.js" asp-append-version="true"></script>
}
