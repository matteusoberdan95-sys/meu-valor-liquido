@page "/blog/{slug}"
@model MeuValorLiquido.WebApp.Pages.Blog.PostModel
@{
    ViewData["Title"] = Model.Post?.Title ?? "Artigo";
    ViewData["Description"] = Model.Post?.Summary ?? "Artigo educativo do Meu Valor Líquido.";
    ViewData["OgType"] = "article";
    ViewData["CanonicalPath"] = Model.Post is null ? "/blog" : $"/blog/{Model.Post.Slug}";
}

@if (Model.Post is null)
{
    <h1>Artigo não encontrado</h1>
    <a asp-page="/Blog/Index">Voltar para o blog</a>
}
else
{
    @section Head {
        <partial name="Shared/_JsonLdArticle" model="Model.Post" />
    }

    <article class="mvl-form-card p-4">
        <h1>@Model.Post.Title</h1>
        <p class="text-muted">Publicado em @Model.Post.PublishedAt.ToString("dd/MM/yyyy")</p>
        <p class="lead">@Model.Post.Summary</p>
        <div class="article-body">@Model.Post.Content</div>
        <div class="mvl-disclaimer mt-4">Este conteúdo tem finalidade educativa e não substitui orientação profissional.</div>
    </article>
}
