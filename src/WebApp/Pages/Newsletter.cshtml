@page "/newsletter"
@model MeuValorLiquido.WebApp.Pages.NewsletterModel
@{
    ViewData["Title"] = "Newsletter";
    ViewData["Description"] = "Receba novidades sobre calculadoras, conteúdos e atualizações do Meu Valor Líquido.";
    ViewData["CanonicalPath"] = "/newsletter";
}

<h1 class="valora-h1">Newsletter</h1>
<p class="valora-lead valora-section">Cadastre seu e-mail para receber conteúdos educativos sobre salário, descontos e finanças pessoais.</p>

@if (Model.Subscribed)
{
    <div class="valora-alert-success">Inscrição registrada! Se o e-mail de confirmação estiver ativo, verifique sua caixa de entrada e o spam.</div>
}

<form method="post" class="valora-form-card valora-stack-md" style="max-width: 28rem;">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div>
        <label asp-for="Email" class="valora-label">E-mail</label>
        <input asp-for="Email" class="valora-input" type="email" placeholder="seu@email.com" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>
    <p class="valora-text-muted valora-text-sm" style="margin: 0;">Não enviamos spam. Você pode cancelar a inscrição a qualquer momento.</p>
    <button class="valora-btn valora-btn-primary" type="submit">Inscrever-se</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
