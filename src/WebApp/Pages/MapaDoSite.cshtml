@page "/mapa-do-site"
@model MeuValorLiquido.WebApp.Pages.MapaDoSiteModel
@{
    ViewData["Title"] = "Mapa do site";
}

<h1 class="valora-h1">Mapa do site</h1>
<p class="valora-lead">Encontre rapidamente calculadoras, conteúdo e páginas institucionais.</p>

<section class="valora-section">
    <h2 class="valora-h2">Calculadoras</h2>
    <ul class="valora-footer-links" style="flex-direction: column; align-items: flex-start; gap: 0.5rem;">
        @foreach (var calculator in Model.Calculators)
        {
            <li><a asp-page="/Calculadoras/Details" asp-route-slug="@calculator.Slug">@calculator.Name</a></li>
        }
    </ul>
</section>

<section class="valora-section">
    <h2 class="valora-h2">Blog</h2>
    <ul class="valora-footer-links" style="flex-direction: column; align-items: flex-start; gap: 0.5rem;">
        @foreach (var post in Model.Posts)
        {
            <li><a asp-page="/Blog/Post" asp-route-slug="@post.Slug">@post.Title</a></li>
        }
    </ul>
</section>

<section class="valora-section">
    <h2 class="valora-h2">Salário líquido por valor</h2>
    <p class="valora-text-muted valora-text-sm" style="margin-bottom: 1rem;">
        Consultas rápidas para valores brutos comuns (INSS e IRRF estimados).
    </p>
    <p><a asp-page="/SalarioLiquido/Index">Ver todas as faixas salariais</a></p>
</section>

<section class="valora-section">
    <h2 class="valora-h2">CLT x PJ</h2>
    <p class="valora-text-muted valora-text-sm" style="margin-bottom: 1rem;">
        Quanto faturar como PJ para equivaler ao líquido CLT em valores comuns.
    </p>
    <p><a asp-page="/CltPj/Index">Ver comparativos CLT x PJ</a></p>
</section>

<section class="valora-section">
    <h2 class="valora-h2">Jornadas temáticas</h2>
    <p class="valora-text-muted valora-text-sm" style="margin-bottom: 1rem;">
        Guias por momento: desligamento, negociação salarial e transição para PJ.
    </p>
    <ul class="valora-footer-links" style="flex-direction: column; align-items: flex-start; gap: 0.5rem;">
        <li><a href="/desligamento">Desligamento CLT</a></li>
        <li><a href="/negociar-salario">Negociar salário</a></li>
        <li><a href="/virar-pj">Virar PJ</a></li>
    </ul>
</section>

<section class="valora-section">
    <h2 class="valora-h2">Dúvidas populares</h2>
    <p class="valora-text-muted valora-text-sm" style="margin-bottom: 1rem;">
        Respostas sobre salário líquido, INSS, férias, rescisão, PJ e mais.
    </p>
    <p><a asp-page="/Duvidas/Index">Ver todas as dúvidas</a></p>
</section>

<section class="valora-section">
    <h2 class="valora-h2">Meu painel</h2>
    <p class="valora-text-muted valora-text-sm" style="margin-bottom: 1rem;">
        Salve simulações no navegador para revisar depois, sem cadastro.
    </p>
    <p><a asp-page="/MeuPainel/Index">Abrir meu painel</a></p>
</section>

<section class="valora-section">
    <h2 class="valora-h2">Widget incorporável</h2>
    <p class="valora-text-muted valora-text-sm" style="margin-bottom: 1rem;">
        Iframe gratuito para blogs e portais — salário líquido, INSS, IRRF e mais.
    </p>
    <p><a asp-page="/Widget/Index">Ver widgets e código</a></p>
</section>

<section class="valora-section">
    <h2 class="valora-h2">Métricas internas</h2>
    <p class="valora-text-muted valora-text-sm" style="margin-bottom: 1rem;">
        Contadores agregados de uso (sem dados pessoais).
    </p>
    <p><a asp-page="/MetricasInternas/Index">Ver métricas internas</a></p>
</section>

<section class="valora-section">
    <h2 class="valora-h2">Institucional</h2>
    <ul class="valora-footer-links" style="flex-direction: column; align-items: flex-start; gap: 0.5rem;">
        <li><a asp-page="/Sobre">Sobre</a></li>
        <li><a asp-page="/ComoCalculamos">Como calculamos</a></li>
        <li><a asp-page="/Contato">Contato</a></li>
        <li><a asp-page="/Newsletter">Newsletter</a></li>
        <li><a asp-page="/PoliticaDePrivacidade">Política de Privacidade</a></li>
        <li><a asp-page="/PoliticaDeCookies">Política de Cookies</a></li>
        <li><a asp-page="/TermosDeUso">Termos de Uso</a></li>
        <li><a asp-page="/AvisoLegal">Aviso Legal</a></li>
    </ul>
</section>
