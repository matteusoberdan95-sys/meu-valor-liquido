@page "/meu-painel"
@model MeuValorLiquido.WebApp.Pages.MeuPainel.IndexModel
@{
    ViewData["Title"] = "Meu painel — simulações salvas";
    ViewData["BottomNavTab"] = "profile";
}

@section Head {
    <partial name="Shared/_JsonLdBreadcrumb" model="SeoMetadataHelper.LocalPanelBreadcrumbs()" />
}

<div class="valora-stitch-panel">
    <header class="valora-stitch-panel-hero">
        <div class="valora-stitch-panel-hero-icon" aria-hidden="true">
            <span class="material-symbols-outlined">person</span>
        </div>
        <h1 class="valora-stitch-panel-title">Meu painel</h1>
        <p class="valora-stitch-panel-lead">
            Simulações que você salvou para revisar depois. Tudo fica no seu navegador —
            sem login e sem enviar números ao servidor.
        </p>
    </header>

    <div class="valora-stitch-panel-body">
    <section class="valora-stitch-panel-card" data-local-panel-page>
        <div class="valora-stitch-panel-toolbar">
            <p class="valora-stitch-panel-count" data-local-panel-count-label>Carregando simulações…</p>
            <button type="button" class="valora-btn valora-btn-outline valora-btn-sm" data-local-panel-clear hidden>
                Limpar tudo
            </button>
        </div>

        <div class="valora-stitch-panel-empty" data-local-panel-empty hidden>
            <span class="material-symbols-outlined valora-stitch-panel-empty-icon" aria-hidden="true">bookmark_add</span>
            <h2 class="valora-stitch-panel-empty-title">Nenhuma simulação salva ainda</h2>
            <p class="valora-stitch-panel-empty-text">
                Depois de calcular, use <strong>Salvar no painel</strong> no bloco de compartilhamento.
            </p>
            <a class="valora-btn valora-btn-primary" asp-page="/Calculadoras/Index">Ir para calculadoras</a>
        </div>

        <ul class="valora-stitch-panel-list valora-local-panel-list" data-local-panel-list hidden></ul>
    </section>

    <section class="valora-stitch-panel-privacy">
        <h2 class="valora-stitch-panel-privacy-title">Privacidade</h2>
        <p>
            Os dados ficam em <code>localStorage</code> deste navegador. Limpar cache, usar outro aparelho
            ou navegador anônimo remove o histórico. Não usamos essas simulações para anúncios nem analytics individualizados.
        </p>
    </section>
    </div>

    <div class="valora-disclaimer valora-stitch-panel-disclaimer">
        <span class="material-symbols-outlined" aria-hidden="true">info</span>
        <p style="margin: 0;">Estimativas educativas. Confirme valores com holerite, contrato ou profissional habilitado.</p>
    </div>
</div>
