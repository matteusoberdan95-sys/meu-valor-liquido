@page "/calculadoras/{slug}"
@model MeuValorLiquido.WebApp.Pages.Calculadoras.DetailsModel
@{
    ViewData["Title"] = Model.Definition?.SeoTitle ?? "Calculadora";
    ViewData["Description"] = Model.Definition?.SeoDescription ?? "Calculadora do Meu Valor Líquido.";
    ViewData["CanonicalPath"] = Model.Definition is null ? "/calculadoras" : $"/calculadoras/{Model.Definition.Slug}";
    if (!Model.IsEmbedMode)
    {
        ViewData["BottomNavTab"] = "calc";
    }
    var profile = Model.FieldProfile;
    var calculatorSlug = Model.Definition?.Slug ?? string.Empty;
    var isRescisaoCalculator = calculatorSlug.Equals("rescisao-clt", StringComparison.OrdinalIgnoreCase);
    var hideDatesInMainForm = profile.ShowLayeredOptionalFields
        && calculatorSlug.Equals("decimo-terceiro", StringComparison.OrdinalIgnoreCase);
    if (Model.IsEmbedMode)
    {
        Layout = "Shared/_EmbedLayout";
        ViewData["Title"] = Model.Definition?.Name ?? "Calculadora";
    }
}

@if (Model.Definition is null)
{
    ViewData["Robots"] = SeoMetadataHelper.NoIndexRobots;
    <h1 class="valora-h1">Calculadora não encontrada</h1>
    <p class="valora-text-muted">Confira a lista de calculadoras disponíveis.</p>
    <a class="valora-btn valora-btn-primary" asp-page="/Calculadoras/Index">Voltar para calculadoras</a>
}
else
{
    if (!Model.IsEmbedMode)
    {
        @section Head {
            <partial name="Shared/_JsonLdFaq" model="Model.Definition.FaqItems" />
            <partial name="Shared/_JsonLdBreadcrumb" model="SeoMetadataHelper.CalculatorBreadcrumbs(Model.Definition.Name, Model.Definition.Slug)" />
        }
    }

    <div class="@(Model.IsEmbedMode ? "valora-embed-page" : Model.IsPjVsCltStitch ? "valora-stitch-cltpj" : Model.IsRescisaoStitch ? "valora-stitch-rescisao" : $"valora-stitch-calc-detail{Model.CalcDetailModifierClass}")">
        @if (!Model.IsEmbedMode && Model.IsPjVsCltStitch)
        {
            <nav class="valora-breadcrumb valora-stitch-cltpj-breadcrumb" aria-label="breadcrumb">
                <ol class="valora-breadcrumb">
                    <li><a asp-page="/Index">Início</a></li>
                    <li><span class="material-symbols-outlined" style="font-size: 1rem;">chevron_right</span></li>
                    <li><a asp-page="/Calculadoras/Index">Calculadoras</a></li>
                    <li><span class="material-symbols-outlined" style="font-size: 1rem;">chevron_right</span></li>
                    <li class="active" aria-current="page">PJ vs CLT</li>
                </ol>
            </nav>

            <h1 class="valora-stitch-cltpj-title">Comparador Salário CLT vs Prestação de Serviços PJ</h1>

            <div class="valora-stitch-cltpj-disclaimer">
                <span class="material-symbols-outlined" aria-hidden="true">info</span>
                <p>Esta é uma ferramenta educativa. Os valores são estimativas baseadas nas tabelas vigentes e não substituem consulta contábil profissional.</p>
            </div>

            @if (Model.TopAdSlot is not null)
            {
                <partial name="Shared/_AdSlot" model="Model.TopAdSlot" />
            }
        }
        else if (!Model.IsEmbedMode && Model.IsRescisaoStitch)
        {
            <nav class="valora-breadcrumb valora-stitch-rescisao-breadcrumb" aria-label="breadcrumb">
                <ol class="valora-breadcrumb">
                    <li><a asp-page="/Index">Início</a></li>
                    <li><span class="material-symbols-outlined" style="font-size: 1rem;">chevron_right</span></li>
                    <li><a asp-page="/Calculadoras/Index">Calculadoras</a></li>
                    <li><span class="material-symbols-outlined" style="font-size: 1rem;">chevron_right</span></li>
                    <li class="active" aria-current="page">@Model.Definition.Name</li>
                </ol>
            </nav>

            <header class="valora-stitch-rescisao-header">
                <div class="valora-stitch-rescisao-meta">
                    <span class="valora-stitch-rescisao-category">TRABALHISTA</span>
                </div>
                <h1 class="valora-stitch-rescisao-title">@Model.Definition.Name</h1>
                <p class="valora-stitch-rescisao-lead">@Model.Definition.Summary</p>
            </header>

            @if (Model.TopAdSlot is not null)
            {
                <partial name="Shared/_AdSlot" model="Model.TopAdSlot" />
            }
        }
        else if (!Model.IsEmbedMode)
        {
            <nav class="valora-breadcrumb valora-stitch-calc-detail-breadcrumb" aria-label="breadcrumb">
                <ol class="valora-breadcrumb">
                    <li><a asp-page="/Index">Início</a></li>
                    <li><span class="material-symbols-outlined" style="font-size: 1rem;">chevron_right</span></li>
                    <li><a asp-page="/Calculadoras/Index">Calculadoras</a></li>
                    <li><span class="material-symbols-outlined" style="font-size: 1rem;">chevron_right</span></li>
                    <li class="active" aria-current="page">@Model.Definition.Name</li>
                </ol>
            </nav>

            <header class="valora-stitch-calc-detail-hero">
                <div class="valora-stitch-calc-detail-hero-row">
                    <a class="valora-stitch-calc-back" asp-page="/Calculadoras/Index" aria-label="Voltar para calculadoras">
                        <span class="material-symbols-outlined" aria-hidden="true">arrow_back</span>
                    </a>
                    <div class="valora-stitch-calc-detail-head">
                        <span class="valora-stitch-calc-detail-badge">@CalculatorUiHelper.GetSimulationBadge(Model.Definition.Category)</span>
                        <h1 class="valora-stitch-calc-detail-title">@Model.Definition.Name</h1>
                    </div>
                </div>
                <div class="valora-stitch-calc-progress" aria-hidden="true">
                    <span class="valora-stitch-calc-progress-bar"></span>
                </div>
            </header>

            <p class="valora-stitch-calc-detail-lead">@Model.Definition.Summary</p>

            @if (Model.IsLayeredFiscalDetail)
            {
                <div class="valora-stitch-calc-fiscal-hint">
                    <span class="material-symbols-outlined" aria-hidden="true">table_chart</span>
                    <p>Simulação com tabelas vigentes de INSS e IRRF. Use &quot;Ajustar detalhes&quot; para dependentes e opções avançadas.</p>
                </div>
            }

            @if (Model.TopAdSlot is not null)
            {
                <partial name="Shared/_AdSlot" model="Model.TopAdSlot" />
            }
        }
        else
        {
            <header class="valora-embed-header">
                <h1 class="valora-h3" style="margin: 0;">@Model.Definition.Name</h1>
                <p class="valora-text-muted valora-text-sm" style="margin: 0.35rem 0 0;">@Model.Definition.Summary</p>
            </header>
        }

        <div class="@(Model.IsEmbedMode ? "valora-embed-stack" : Model.IsPjVsCltStitch ? "valora-stitch-cltpj-layout" : "valora-stitch-calc-detail-grid")">
        <div class="valora-stack-md @(Model.IsPjVsCltStitch ? "valora-stitch-cltpj-main" : "valora-stitch-calc-detail-main")">
            @if (Model.IsPjVsCltStitch)
            {
                <partial name="Shared/_PjVsCltStitchForm" model="Model" />
            }
            else
            {
            <form method="post"
                  class="@(Model.IsEmbedMode ? "valora-form-card valora-stack-md" : $"valora-form-card valora-stitch-calc-form valora-stack-md{(Model.IsRescisaoStitch ? " valora-stitch-rescisao-form" : "")}")"
                  asp-route-slug="@Model.Definition.Slug"
                  asp-route-embed="@(Model.IsEmbedMode ? "1" : null)">
                <h2 class="@(Model.IsEmbedMode ? "valora-h3" : "valora-stitch-calc-form-title")">
                    @if (!Model.IsEmbedMode)
                    {
                        <span class="material-symbols-outlined" aria-hidden="true">edit_note</span>
                    }
                    @(Model.IsRescisaoStitch ? "Dados do Contrato" : "Informe seus dados")
                </h2>
                @if (Model.IsRescisaoStitch)
                {
                    <div class="valora-stitch-rescisao-form-note">
                        <span class="material-symbols-outlined" aria-hidden="true">info</span>
                        <p>Informe salário, datas e motivo do desligamento. O cálculo considera saldo de salário, aviso prévio, férias, 13º e descontos legais.</p>
                    </div>
                }
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="valora-form-row">
                    @if (profile.ShowTerminationReason)
                    {
                        <div style="grid-column: 1 / -1;">
                            <span class="valora-label">@profile.TerminationReasonLabel</span>
                            <div class="valora-choice-group" role="radiogroup" aria-label="@profile.TerminationReasonLabel">
                                @foreach (var option in Html.GetEnumSelectList<MeuValorLiquido.Modules.Calculators.TerminationReason>())
                                {
                                    var optionId = $"Input_TerminationReason_{option.Value}";
                                    <label class="valora-choice" for="@optionId">
                                        <input type="radio"
                                               asp-for="Input.TerminationReason"
                                               id="@optionId"
                                               value="@option.Value" />
                                        <span class="valora-choice-text">@option.Text</span>
                                    </label>
                                }
                            </div>
                            <p class="valora-helper">Sem justa causa, pedido de demissão, acordo comum (484-A) ou justa causa — cada tipo tem verbas e direitos diferentes.</p>
                        </div>
                    }
                    @if (profile.ShowAdmissionDate && !hideDatesInMainForm)
                    {
                        <div>
                            <label asp-for="Input.AdmissionDate" class="valora-label">@profile.AdmissionDateLabel</label>
                            <input asp-for="Input.AdmissionDate" class="valora-input" type="date" />
                            <p class="valora-helper">Usada para calcular tempo na empresa, 13º e férias proporcionais automaticamente.</p>
                        </div>
                    }
                    @if (profile.ShowTerminationDate && !hideDatesInMainForm)
                    {
                        <div>
                            <label asp-for="Input.TerminationDate" class="valora-label">@profile.TerminationDateLabel</label>
                            <input asp-for="Input.TerminationDate" class="valora-input" type="date" />
                            <p class="valora-helper">O dia da saída define os dias trabalhados no último mês, se você não informar manualmente.</p>
                        </div>
                    }
                    @if (profile.ShowNoticePeriodOptions)
                    {
                        <div style="grid-column: 1 / -1;">
                            <label asp-for="Input.NoticePeriod" class="valora-label">@profile.NoticePeriodOptionLabel</label>
                            <select asp-for="Input.NoticePeriod" class="valora-input" asp-items="Html.GetEnumSelectList<MeuValorLiquido.Modules.Calculators.NoticePeriodOption>()"></select>
                            <p class="valora-helper">No pedido de demissão, &quot;Não cumprido&quot; gera desconto de até 30 dias. Na demissão sem justa causa, &quot;Indenizado&quot; inclui aviso na rescisão.</p>
                        </div>
                    }
                    @if (profile.ShowAmount && profile.ShowAdmissionDate)
                    {
                        <div>
                            <label asp-for="Input.Amount" class="valora-label">@profile.AmountLabel</label>
                            <div class="valora-input-prefix">
                                <span class="valora-prefix">R$</span>
                                <input asp-for="Input.Amount" class="valora-input" type="text" data-mask="currency" placeholder="0,00" />
                            </div>
                            <span asp-validation-for="Input.Amount" class="text-danger"></span>
                        </div>
                    }
                    @if (profile.ShowSecondaryAmount && profile.ShowAdmissionDate)
                    {
                        <div>
                            <label asp-for="Input.SecondaryAmount" class="valora-label">@profile.SecondaryAmountLabel</label>
                            <input asp-for="Input.SecondaryAmount" class="valora-input" type="text" data-mask="integer" data-max-length="2" inputmode="numeric" placeholder="30" />
                            <p class="valora-helper">Preenchido automaticamente pelo dia da data de afastamento, se você informar a data.</p>
                        </div>
                    }
                    @if (hideDatesInMainForm)
                    {
                        <details class="valora-form-advanced" style="grid-column: 1 / -1; margin-top: 0.5rem;">
                            <summary class="valora-label" style="cursor: pointer; list-style: none; display: flex; align-items: center; gap: 0.35rem;">
                                <span class="material-symbols-outlined" style="font-size: 1.125rem;" aria-hidden="true">tune</span>
                                @profile.LayeredOptionalSectionLabel
                            </summary>
                            <div class="valora-form-row" style="margin-top: 1rem;">
                                <div>
                                    <label asp-for="Input.AdmissionDate" class="valora-label">@profile.AdmissionDateLabel</label>
                                    <input asp-for="Input.AdmissionDate" class="valora-input" type="date" />
                                </div>
                                <div>
                                    <label asp-for="Input.TerminationDate" class="valora-label">@profile.TerminationDateLabel</label>
                                    <input asp-for="Input.TerminationDate" class="valora-input" type="date" />
                                </div>
                                @if (profile.ShowDependents)
                                {
                                    <div>
                                        <label asp-for="Input.Dependents" class="valora-label">@profile.DependentsLabel</label>
                                        <input asp-for="Input.Dependents" class="valora-input" type="text" data-mask="integer" data-max-length="2" inputmode="numeric" placeholder="0" />
                                    </div>
                                }
                                @if (profile.ShowThirteenthAdvance)
                                {
                                    <div style="grid-column: 1 / -1;">
                                        <label asp-for="Input.ThirteenthAdvancePaid" class="valora-label">@profile.ThirteenthAdvancePaidLabel</label>
                                        <div class="valora-input-prefix">
                                            <span class="valora-prefix">R$</span>
                                            <input asp-for="Input.ThirteenthAdvancePaid" class="valora-input" type="text" data-mask="currency" placeholder="0,00" />
                                        </div>
                                        <p class="valora-helper">Valor já recebido como adiantamento da 1ª parcela do 13º no ano.</p>
                                    </div>
                                }
                            </div>
                        </details>
                    }
                    @if (profile.ShowDependents && profile.ShowAdmissionDate && profile.ShowLayeredOptionalFields && !hideDatesInMainForm)
                    {
                        <details class="valora-form-advanced" style="grid-column: 1 / -1; margin-top: 0.5rem;">
                            <summary class="valora-label" style="cursor: pointer; list-style: none; display: flex; align-items: center; gap: 0.35rem;">
                                <span class="material-symbols-outlined" style="font-size: 1.125rem;" aria-hidden="true">tune</span>
                                @profile.LayeredOptionalSectionLabel
                            </summary>
                            <div class="valora-form-row" style="margin-top: 1rem;">
                                <partial name="Shared/_VacationAdvancedOptions" model="Model" />
                                <div>
                                    <label asp-for="Input.Dependents" class="valora-label">@profile.DependentsLabel</label>
                                    <input asp-for="Input.Dependents" class="valora-input" type="text" data-mask="integer" data-max-length="2" inputmode="numeric" placeholder="0" />
                                </div>
                            </div>
                        </details>
                    }
                    else if (profile.ShowDependents && profile.ShowAdmissionDate)
                    {
                        <div>
                            <label asp-for="Input.Dependents" class="valora-label">@profile.DependentsLabel</label>
                            <input asp-for="Input.Dependents" class="valora-input" type="text" data-mask="integer" data-max-length="2" inputmode="numeric" placeholder="0" />
                        </div>
                    }
                    @if (profile.ShowTransportDiscount && profile.ShowAdmissionDate)
                    {
                        <div style="grid-column: 1 / -1;">
                            <label asp-for="Input.TransportDiscount" class="valora-label">@profile.TransportDiscountLabel</label>
                            <div class="valora-input-prefix">
                                <span class="valora-prefix">R$</span>
                                <input asp-for="Input.TransportDiscount" class="valora-input" type="text" data-mask="currency" placeholder="0,00" />
                            </div>
                        </div>
                    }
                    @if (profile.ShowFgtsTerminationReason)
                    {
                        <div style="grid-column: 1 / -1;">
                            <span class="valora-label">@profile.FgtsTerminationReasonLabel</span>
                            <div class="valora-choice-group" role="radiogroup" aria-label="@profile.FgtsTerminationReasonLabel">
                                @foreach (var option in Html.GetEnumSelectList<MeuValorLiquido.Modules.Calculators.TerminationReason>())
                                {
                                    var optionId = $"Input_TerminationReason_fgts_{option.Value}";
                                    <label class="valora-choice" for="@optionId">
                                        <input type="radio"
                                               asp-for="Input.TerminationReason"
                                               id="@optionId"
                                               value="@option.Value" />
                                        <span class="valora-choice-text">@option.Text</span>
                                    </label>
                                }
                            </div>
                            <p class="valora-helper">Multa de 40% na demissão sem justa causa, 20% no acordo 484-A. Pedido de demissão e justa causa não geram multa.</p>
                        </div>
                    }
                    @if (profile.ShowSalaryBasis)
                    {
                        <div style="grid-column: 1 / -1;">
                            <span class="valora-label">@profile.SalaryBasisLabel</span>
                            <div class="valora-choice-group" role="radiogroup" aria-label="@profile.SalaryBasisLabel">
                                @foreach (var option in Html.GetEnumSelectList<MeuValorLiquido.Modules.Calculators.SalaryConversionBasis>())
                                {
                                    var optionId = $"Input_SalaryBasis_{option.Value}";
                                    <label class="valora-choice" for="@optionId">
                                        <input type="radio"
                                               asp-for="Input.SalaryBasis"
                                               id="@optionId"
                                               value="@option.Value" />
                                        <span class="valora-choice-text">@option.Text</span>
                                    </label>
                                }
                            </div>
                        </div>
                    }
                    @if (profile.ShowFinancingAmortization)
                    {
                        <div style="grid-column: 1 / -1;">
                            <span class="valora-label">@profile.FinancingAmortizationLabel</span>
                            <div class="valora-choice-group" role="radiogroup" aria-label="@profile.FinancingAmortizationLabel">
                                @foreach (var option in Html.GetEnumSelectList<MeuValorLiquido.Modules.Calculators.FinancingAmortizationSystem>())
                                {
                                    var optionId = $"Input_FinancingAmortization_{option.Value}";
                                    <label class="valora-choice" for="@optionId">
                                        <input type="radio"
                                               asp-for="Input.FinancingAmortization"
                                               id="@optionId"
                                               value="@option.Value" />
                                        <span class="valora-choice-text">@option.Text</span>
                                    </label>
                                }
                            </div>
                            <p class="valora-helper">No SAC as parcelas começam maiores e os juros totais costumam ser menores que no Price.</p>
                        </div>
                    }
                    @if (profile.ShowMeiActivity)
                    {
                        <div style="grid-column: 1 / -1;">
                            <span class="valora-label">@profile.MeiActivityLabel</span>
                            <div class="valora-choice-group" role="radiogroup" aria-label="@profile.MeiActivityLabel">
                                @foreach (var option in Html.GetEnumSelectList<MeuValorLiquido.Modules.Calculators.Tax.MeiActivityType>())
                                {
                                    var optionId = $"Input_MeiActivity_{option.Value}";
                                    <label class="valora-choice" for="@optionId">
                                        <input type="radio"
                                               asp-for="Input.MeiActivity"
                                               id="@optionId"
                                               value="@option.Value" />
                                        <span class="valora-choice-text">@option.Text</span>
                                    </label>
                                }
                            </div>
                        </div>
                    }
                    @if (profile.ShowNoticePeriod && !profile.ShowNoticePeriodOptions)
                    {
                        <div style="grid-column: 1 / -1;">
                            <span class="valora-label">@profile.NoticePeriodLabel</span>
                            <div class="valora-choice-group" role="radiogroup" aria-label="@profile.NoticePeriodLabel">
                                <label class="valora-choice" for="Input_CompletedNoticePeriod_true">
                                    <input type="radio" asp-for="Input.CompletedNoticePeriod" id="Input_CompletedNoticePeriod_true" value="true" />
                                    <span class="valora-choice-text">Sim, cumpri aviso</span>
                                </label>
                                <label class="valora-choice" for="Input_CompletedNoticePeriod_false">
                                    <input type="radio" asp-for="Input.CompletedNoticePeriod" id="Input_CompletedNoticePeriod_false" value="false" />
                                    <span class="valora-choice-text">Não cumpri aviso</span>
                                </label>
                            </div>
                            <p class="valora-helper">No pedido de demissão sem aviso, a empresa pode descontar até 30 dias de salário.</p>
                        </div>
                    }
                    @if (profile.ShowHasUnpaidVacation || profile.ShowVacationTakenInPeriod || profile.ShowMonthsSinceLastVacation || profile.ShowCompleteYears || profile.ShowFgtsBalance || profile.ShowAdmissionMonth || profile.ShowAdmissionInPriorYear || profile.ShowTerminationMonth || profile.ShowThirteenthMonths || (profile.ShowMonths && isRescisaoCalculator))
                    {
                    <details class="valora-form-advanced" style="grid-column: 1 / -1; margin-top: 0.5rem;">
                        <summary class="valora-label" style="cursor: pointer; list-style: none; display: flex; align-items: center; gap: 0.35rem;">
                            <span class="material-symbols-outlined" style="font-size: 1.125rem;" aria-hidden="true">tune</span>
                            Ajustar detalhes (férias, FGTS, meses)
                        </summary>
                        <div class="valora-form-row" style="margin-top: 1rem;">
                    }
                    @if (profile.ShowHasUnpaidVacation)
                    {
                        <div style="grid-column: 1 / -1;">
                            <label class="valora-choice" for="Input_HasUnpaidVacation" style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
                                <input type="checkbox" asp-for="Input.HasUnpaidVacation" id="Input_HasUnpaidVacation" />
                                <span>@profile.HasUnpaidVacationLabel</span>
                            </label>
                            <p class="valora-helper">Só marque se completou 12 meses ou mais sem gozar férias em algum período. Com menos de 12 meses, use apenas as férias proporcionais.</p>
                        </div>
                    }
                    @if (profile.ShowVacationTakenInPeriod)
                    {
                        <div style="grid-column: 1 / -1;">
                            <label class="valora-choice" for="Input_VacationTakenInCurrentPeriod" style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
                                <input type="checkbox" asp-for="Input.VacationTakenInCurrentPeriod" id="Input_VacationTakenInCurrentPeriod" />
                                <span>@profile.VacationTakenInPeriodLabel</span>
                            </label>
                            <p class="valora-helper">Se já gozou férias completas no período, não há férias proporcionais. Use o campo abaixo se gozou parcialmente.</p>
                        </div>
                    }
                    @if (profile.ShowMonthsSinceLastVacation)
                    {
                        <div>
                            <label asp-for="Input.MonthsSinceLastVacation" class="valora-label">@profile.MonthsSinceLastVacationLabel</label>
                            <input asp-for="Input.MonthsSinceLastVacation" class="valora-input" type="text" data-mask="integer" data-max-length="2" inputmode="numeric" placeholder="0" />
                        </div>
                    }
                    @if (profile.ShowCompleteYears)
                    {
                        <div>
                            <label asp-for="Input.CompleteYears" class="valora-label">@profile.CompleteYearsLabel</label>
                            <input asp-for="Input.CompleteYears" class="valora-input" type="text" data-mask="integer" data-max-length="2" inputmode="numeric" placeholder="0" />
                            <p class="valora-helper">Deixe 0 para calcular pelos meses informados. Usado no aviso prévio indenizado (+3 dias/ano).</p>
                        </div>
                    }
                    @if (profile.ShowFgtsBalance)
                    {
                        <div>
                            <label asp-for="Input.FgtsBalance" class="valora-label">@profile.FgtsBalanceLabel</label>
                            <div class="valora-input-prefix">
                                <span class="valora-prefix">R$</span>
                                <input asp-for="Input.FgtsBalance" class="valora-input" type="text" data-mask="currency" placeholder="0,00" />
                            </div>
                        </div>
                    }
                    @if (profile.ShowAmount && !profile.ShowAdmissionDate)
                    {
                        <div>
                            <label asp-for="Input.Amount" class="valora-label">@profile.AmountLabel</label>
                            @if (profile.AmountIsCurrency)
                            {
                                <div class="valora-input-prefix">
                                    <span class="valora-prefix">R$</span>
                                    <input asp-for="Input.Amount" class="valora-input" type="text" data-mask="currency" placeholder="0,00" />
                                </div>
                            }
                            else
                            {
                                <input asp-for="Input.Amount" class="valora-input" type="text" data-mask="decimal" inputmode="decimal" />
                            }
                            <span asp-validation-for="Input.Amount" class="text-danger"></span>
                        </div>
                    }
                    @if (profile.ShowIrrfGrossSalaryToggle)
                    {
                        <div style="grid-column: 1 / -1;">
                            <label class="valora-choice" for="Input_IrrfFromGrossSalary" style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
                                <input type="checkbox" asp-for="Input.IrrfFromGrossSalary" id="Input_IrrfFromGrossSalary" />
                                <span>@profile.IrrfGrossSalaryToggleLabel</span>
                            </label>
                            <p class="valora-helper">Desmarcado: informe a base já sem INSS. Marcado: informe o salário bruto e o INSS será estimado automaticamente.</p>
                        </div>
                    }
                    @if (profile.ShowSecondaryAmount && !profile.ShowAdmissionDate)
                    {
                        <div>
                            <label asp-for="Input.SecondaryAmount" class="valora-label">@profile.SecondaryAmountLabel</label>
                            @if (profile.SecondaryAmountIsDays)
                            {
                                <input asp-for="Input.SecondaryAmount" class="valora-input" type="text" data-mask="integer" data-max-length="2" inputmode="numeric" placeholder="30" />
                            }
                            else if (profile.AmountIsCurrency)
                            {
                                <div class="valora-input-prefix">
                                    <span class="valora-prefix">R$</span>
                                    <input asp-for="Input.SecondaryAmount" class="valora-input" type="text" data-mask="currency" placeholder="0,00" />
                                </div>
                            }
                            else
                            {
                                <input asp-for="Input.SecondaryAmount" class="valora-input" type="text" data-mask="decimal" inputmode="decimal" />
                            }
                        </div>
                    }
                    @if (profile.ShowMonths)
                    {
                        <div>
                            <label asp-for="Input.Months" class="valora-label">@profile.MonthsLabel</label>
                            <input asp-for="Input.Months" class="valora-input" type="text" data-mask="integer" data-max-length="3" inputmode="numeric" placeholder="12" />
                            @if (profile.ShowVacationOptions)
                            {
                                <p class="valora-helper">12 meses = férias integrais. Com datas de admissão e saída, os meses são calculados automaticamente.</p>
                            }
                            else if (isRescisaoCalculator)
                            {
                                <p class="valora-helper">Conte da data de admissão até a rescisão. Ex.: junho a agosto = 3 meses (não 10).</p>
                            }
                            else if (calculatorSlug.Equals("decimo-terceiro", StringComparison.OrdinalIgnoreCase))
                            {
                                <p class="valora-helper">Avos trabalhados no ano (regra dos 15 dias). Use as datas ou informe manualmente.</p>
                            }
                            else
                            {
                                <p class="valora-helper">Conte da data de admissão até a rescisão. Ex.: junho a agosto = 3 meses (não 10).</p>
                            }
                        </div>
                    }
                    @if (profile.ShowAdmissionMonth)
                    {
                        <div>
                            <label asp-for="Input.AdmissionMonth" class="valora-label">@profile.AdmissionMonthLabel</label>
                            <select asp-for="Input.AdmissionMonth" class="valora-input">
                                <option value="0">Não sei / estimar</option>
                                <option value="1">Janeiro</option>
                                <option value="2">Fevereiro</option>
                                <option value="3">Março</option>
                                <option value="4">Abril</option>
                                <option value="5">Maio</option>
                                <option value="6">Junho</option>
                                <option value="7">Julho</option>
                                <option value="8">Agosto</option>
                                <option value="9">Setembro</option>
                                <option value="10">Outubro</option>
                                <option value="11">Novembro</option>
                                <option value="12">Dezembro</option>
                            </select>
                            <p class="valora-helper">Ajuda a validar o tempo na empresa e o 13º do ano da saída.</p>
                        </div>
                    }
                    @if (profile.ShowAdmissionInPriorYear)
                    {
                        <div style="grid-column: 1 / -1;">
                            <label class="valora-choice" for="Input_AdmissionInPriorYear" style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
                                <input type="checkbox" asp-for="Input.AdmissionInPriorYear" id="Input_AdmissionInPriorYear" />
                                <span>@profile.AdmissionInPriorYearLabel</span>
                            </label>
                            <p class="valora-helper">Marque se entrou no ano passado. Ex.: admitido em novembro e saiu em fevereiro do ano seguinte.</p>
                        </div>
                    }
                    @if (profile.ShowTerminationMonth)
                    {
                        <div>
                            <label asp-for="Input.TerminationMonth" class="valora-label">@profile.TerminationMonthLabel</label>
                            <select asp-for="Input.TerminationMonth" class="valora-input">
                                <option value="0">Selecione o mês</option>
                                <option value="1">Janeiro</option>
                                <option value="2">Fevereiro</option>
                                <option value="3">Março</option>
                                <option value="4">Abril</option>
                                <option value="5">Maio</option>
                                <option value="6">Junho</option>
                                <option value="7">Julho</option>
                                <option value="8">Agosto</option>
                                <option value="9">Setembro</option>
                                <option value="10">Outubro</option>
                                <option value="11">Novembro</option>
                                <option value="12">Dezembro</option>
                            </select>
                            <p class="valora-helper">Usado para o 13º proporcional quando você não informar os meses trabalhados no ano da saída.</p>
                        </div>
                    }
                    @if (profile.ShowThirteenthMonths)
                    {
                        <div>
                            <label asp-for="Input.MonthsWorkedInYear" class="valora-label">@profile.ThirteenthMonthsLabel</label>
                            <input asp-for="Input.MonthsWorkedInYear" class="valora-input" type="text" data-mask="integer" data-max-length="2" inputmode="numeric" placeholder="0" />
                            <p class="valora-helper">Opcional. Deixe 0 para calcular pelo mês da rescisão e tempo na empresa.</p>
                        </div>
                    }
                        </div>
                    </details>
                    }
                    @if (profile.ShowRate)
                    {
                        <div>
                            <label asp-for="Input.Rate" class="valora-label">@profile.RateLabel</label>
                            <input asp-for="Input.Rate" class="valora-input" type="text" data-mask="decimal" inputmode="decimal" placeholder="0" />
                        </div>
                    }
                    @if (profile.ShowHours)
                    {
                        <div>
                            <label asp-for="Input.Hours" class="valora-label">@profile.HoursLabel</label>
                            <input asp-for="Input.Hours" class="valora-input" type="text" data-mask="decimal" inputmode="decimal" placeholder="0" />
                        </div>
                    }
                    @if (profile.ShowWeeklyWorkHours)
                    {
                        <div>
                            <label asp-for="Input.WeeklyWorkHours" class="valora-label">@profile.WeeklyWorkHoursLabel</label>
                            <select asp-for="Input.WeeklyWorkHours" class="valora-input">
                                <option value="0">44h (divisor 220 — padrão CLT)</option>
                                <option value="40">40h (divisor 200)</option>
                                <option value="36">36h (divisor 180)</option>
                                <option value="30">30h (divisor 150)</option>
                            </select>
                        </div>
                    }
                    @if (profile.ShowOvertimeShiftType)
                    {
                        <div style="grid-column: 1 / -1;">
                            <span class="valora-label">@profile.OvertimeShiftTypeLabel</span>
                            <div class="valora-choice-group" role="radiogroup" aria-label="@profile.OvertimeShiftTypeLabel">
                                @foreach (var option in Html.GetEnumSelectList<MeuValorLiquido.Modules.Calculators.OvertimeShiftType>())
                                {
                                    var optionId = $"Input_OvertimeShiftType_{option.Value}";
                                    <label class="valora-choice" for="@optionId">
                                        <input type="radio"
                                               asp-for="Input.OvertimeShiftType"
                                               id="@optionId"
                                               value="@option.Value" />
                                        <span class="valora-choice-text">@option.Text</span>
                                    </label>
                                }
                            </div>
                        </div>
                    }
                    @if (profile.ShowLayeredOptionalFields && !profile.ShowAdmissionDate)
                    {
                        <details class="valora-form-advanced" style="grid-column: 1 / -1; margin-top: 0.5rem;">
                            <summary class="valora-label" style="cursor: pointer; list-style: none; display: flex; align-items: center; gap: 0.35rem;">
                                <span class="material-symbols-outlined" style="font-size: 1.125rem;" aria-hidden="true">tune</span>
                                @profile.LayeredOptionalSectionLabel
                            </summary>
                            <div class="valora-form-row" style="margin-top: 1rem;">
                                @if (profile.ShowDependents)
                                {
                                    <div>
                                        <label asp-for="Input.Dependents" class="valora-label">@profile.DependentsLabel</label>
                                        <input asp-for="Input.Dependents" class="valora-input" type="text" data-mask="integer" data-max-length="2" inputmode="numeric" placeholder="0" />
                                    </div>
                                }
                                @if (profile.ShowTransportDiscount)
                                {
                                    <div style="grid-column: 1 / -1;">
                                        <label asp-for="Input.TransportDiscount" class="valora-label">@profile.TransportDiscountLabel</label>
                                        <div class="valora-input-prefix">
                                            <span class="valora-prefix">R$</span>
                                            <input asp-for="Input.TransportDiscount" class="valora-input" type="text" data-mask="currency" placeholder="0,00" />
                                        </div>
                                    </div>
                                }
                                @if (profile.ShowOtherDiscounts)
                                {
                                    <div style="grid-column: 1 / -1;">
                                        <label asp-for="Input.OtherDiscounts" class="valora-label">@profile.OtherDiscountsLabel</label>
                                        <div class="valora-input-prefix">
                                            <span class="valora-prefix">R$</span>
                                            <input asp-for="Input.OtherDiscounts" class="valora-input" type="text" data-mask="currency" placeholder="0,00" />
                                        </div>
                                    </div>
                                }
                            </div>
                        </details>
                    }
                    else
                    {
                    @if (profile.ShowDependents && !profile.ShowAdmissionDate)
                    {
                        <div>
                            <label asp-for="Input.Dependents" class="valora-label">@profile.DependentsLabel</label>
                            <input asp-for="Input.Dependents" class="valora-input" type="text" data-mask="integer" data-max-length="2" inputmode="numeric" placeholder="0" />
                        </div>
                    }
                    @if (profile.ShowTransportDiscount && !profile.ShowAdmissionDate)
                    {
                        <div style="grid-column: 1 / -1;">
                            <label asp-for="Input.TransportDiscount" class="valora-label">@profile.TransportDiscountLabel</label>
                            <div class="valora-input-prefix">
                                <span class="valora-prefix">R$</span>
                                <input asp-for="Input.TransportDiscount" class="valora-input" type="text" data-mask="currency" placeholder="0,00" />
                            </div>
                        </div>
                    }
                    @if (profile.ShowOtherDiscounts)
                    {
                        <div style="grid-column: 1 / -1;">
                            <label asp-for="Input.OtherDiscounts" class="valora-label">@profile.OtherDiscountsLabel</label>
                            <div class="valora-input-prefix">
                                <span class="valora-prefix">R$</span>
                                <input asp-for="Input.OtherDiscounts" class="valora-input" type="text" data-mask="currency" placeholder="0,00" />
                            </div>
                        </div>
                    }
                    }
                </div>
                <button class="@(Model.IsEmbedMode ? "valora-btn valora-btn-primary" : "valora-stitch-btn valora-stitch-btn--primary valora-stitch-calc-submit")" type="submit">
                    @(Model.IsEmbedMode ? "Calcular agora" : "CALCULAR AGORA")
                </button>
            </form>
            }

            @if (!Model.IsEmbedMode && !Model.IsPjVsCltStitch && !Model.IsRescisaoStitch)
            {
            <p class="valora-stitch-calc-footer-hint">
                Os resultados são estimativas educativas. Consulte seu RH ou contador para valores oficiais.
            </p>

            <section class="valora-card valora-stitch-calc-edu">
                <h2 class="valora-h3">Como usar esta calculadora</h2>
                <p class="valora-text-muted valora-text-sm" style="margin: 0;">@(Model.Definition.EducationalContent is null ? "Preencha os campos indicados e use o resultado como estimativa educativa." : Html.Raw(Model.Definition.EducationalContent))</p>
            </section>
            }
            else
            {
            <div class="valora-disclaimer">
                <span class="material-symbols-outlined">warning</span>
                <p style="margin: 0;">Os resultados são estimativas educativas baseados nas tabelas vigentes. Consulte seu RH ou contador para valores oficiais.</p>
            </div>
            }
        </div>

        <aside class="@(Model.IsEmbedMode ? "valora-embed-result" : Model.IsPjVsCltStitch ? "valora-stitch-cltpj-aside valora-stack-md" : $"valora-stitch-calc-estimate{(Model.IsRescisaoStitch ? " valora-stitch-rescisao-estimate" : "")} valora-stack-md{(Model.ResultPanel is null ? " valora-stitch-calc-estimate--empty" : "")}")">
            @if (Model.IsPjVsCltStitch)
            {
                @if (Model.CltPjBreakdown is not null)
                {
                    <partial name="Shared/_PjVsCltStitchResults" model="new PjVsCltStitchResultsViewModel(Model.CltPjBreakdown, Model.Share)" />
                    <p class="valora-stitch-cltpj-legal">@Model.Result!.LegalDisclaimer</p>
                }
                else
                {
                    <section class="valora-stitch-cltpj-results-placeholder" aria-live="polite">
                        <p class="valora-stitch-cltpj-verdict-badge">Veredito</p>
                        <h2 class="valora-h3">Seu comparativo aparece aqui</h2>
                        <p class="valora-text-sm">Preencha os dados CLT e PJ e clique em Calcular.</p>
                    </section>
                }
            }
            else if (Model.ResultPanel is not null)
            {
                @if (!Model.IsEmbedMode)
                {
                    <p class="valora-stitch-calc-estimate-kicker">@(Model.IsRescisaoStitch ? "RESUMO DA RESCISÃO" : "ESTIMATIVA ATUAL")</p>
                }
                <partial name="Shared/_CalculatorResultPanel" model="Model.ResultPanel" />
                @if (Model.IsEmbedMode)
                {
                <div class="valora-disclaimer">
                    <span class="material-symbols-outlined">info</span>
                    <p style="margin: 0;">@Model.Result!.LegalDisclaimer</p>
                </div>
                }
                else
                {
                <p class="valora-stitch-calc-estimate-disclaimer">@Model.Result!.LegalDisclaimer</p>
                }
                @if (Model.Share is not null)
                {
                    <partial name="Shared/_CalculatorResultShare" model="Model.Share" />
                }
            }
            else
            {
                <section class="valora-result-panel valora-stitch-calc-estimate-placeholder" aria-live="polite">
                    @if (!Model.IsEmbedMode)
                    {
                        <p class="valora-stitch-calc-estimate-kicker">@(Model.IsRescisaoStitch ? "RESUMO DA RESCISÃO" : "ESTIMATIVA ATUAL")</p>
                    }
                    <h2 class="valora-h3" style="margin-bottom: 0.5rem;">Seu resultado aparece aqui</h2>
                    <p class="valora-text-sm" style="margin: 0;">Preencha o formulário e clique em Calcular para ver o extrato estimado.</p>
                </section>
            }

            @if (!Model.IsEmbedMode && Model.BottomAdSlot is not null)
            {
                <partial name="Shared/_AdSlot" model="Model.BottomAdSlot" />
            }
        </aside>
    </div>

    @if (!Model.IsEmbedMode)
    {
        <section class="valora-faq @(Model.IsPjVsCltStitch ? "valora-stitch-cltpj-faq" : "valora-stitch-calc-faq")">
            <h2 class="valora-h2">@(Model.IsPjVsCltStitch ? "Perguntas Frequentes" : "Perguntas frequentes")</h2>
            @foreach (var faq in Model.Definition.FaqItems)
            {
                <details>
                    <summary>
                        @faq.Question
                        <span class="material-symbols-outlined">expand_more</span>
                    </summary>
                    <p class="faq-body">@faq.Answer</p>
                </details>
            }
        </section>
    }
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/calculator-input-masks.js" asp-append-version="true"></script>
    @if (Model.ResultPanel is not null && Model.ResultPanel.ShowSimpleExplanation)
    {
        <script src="~/js/calculator-result-views.js" asp-append-version="true"></script>
    }
    @if (Model.Share is not null)
    {
        <script src="~/js/calculator-share.js" asp-append-version="true"></script>
    }
    @if (Model.IsPjVsCltStitch)
    {
        <script src="~/js/pj-vs-clt-wizard.js" asp-append-version="true"></script>
    }
}
