@page "/calculadoras/{slug}"
@model MeuValorLiquido.WebApp.Pages.Calculadoras.DetailsModel
@{
    ViewData["Title"] = Model.Definition?.SeoTitle ?? "Calculadora";
    ViewData["Description"] = Model.Definition?.SeoDescription ?? "Calculadora do Meu Valor Líquido.";
    ViewData["CanonicalPath"] = Model.Definition is null ? "/calculadoras" : $"/calculadoras/{Model.Definition.Slug}";
    var profile = Model.FieldProfile;
}

@if (Model.Definition is null)
{
    <h1 class="valora-h1">Calculadora não encontrada</h1>
    <p class="valora-text-muted">Confira a lista de calculadoras disponíveis.</p>
    <a class="valora-btn valora-btn-primary" asp-page="/Calculadoras/Index">Voltar para calculadoras</a>
}
else
{
    @section Head {
        <partial name="Shared/_JsonLdFaq" model="Model.Definition.FaqItems" />
    }

    <nav aria-label="breadcrumb">
        <ol class="valora-breadcrumb">
            <li><a asp-page="/Index">Início</a></li>
            <li><span class="material-symbols-outlined" style="font-size: 1rem;">chevron_right</span></li>
            <li><a asp-page="/Calculadoras/Index">Calculadoras</a></li>
            <li><span class="material-symbols-outlined" style="font-size: 1rem;">chevron_right</span></li>
            <li class="active" aria-current="page">@Model.Definition.Name</li>
        </ol>
    </nav>

    <header class="valora-section">
        <partial name="Shared/_CalculatorCategoryBadge" model="Model.Definition.Category" />
        <h1 class="valora-h1" style="margin-top: 0.75rem;">@Model.Definition.Name</h1>
        <p class="valora-lead">@Model.Definition.Summary</p>
    </header>

    @if (Model.TopAdSlot is not null)
    {
        <partial name="Shared/_AdSlot" model="Model.TopAdSlot" />
    }

    <div class="valora-calc-layout valora-section">
        <div class="valora-stack-md">
            <form method="post" class="valora-form-card valora-stack-md" asp-route-slug="@Model.Definition.Slug">
                <h2 class="valora-h3">Informe seus dados</h2>
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="valora-form-row">
                    @if (profile.ShowAmount)
                    {
                        <div>
                            <label asp-for="Input.Amount" class="valora-label">@profile.AmountLabel</label>
                            <input asp-for="Input.Amount" class="valora-input" inputmode="decimal" />
                            <span asp-validation-for="Input.Amount" class="text-danger"></span>
                        </div>
                    }
                    @if (profile.ShowSecondaryAmount)
                    {
                        <div>
                            <label asp-for="Input.SecondaryAmount" class="valora-label">@profile.SecondaryAmountLabel</label>
                            <input asp-for="Input.SecondaryAmount" class="valora-input" inputmode="decimal" />
                        </div>
                    }
                    @if (profile.ShowMonths)
                    {
                        <div>
                            <label asp-for="Input.Months" class="valora-label">@profile.MonthsLabel</label>
                            <input asp-for="Input.Months" class="valora-input" inputmode="numeric" />
                        </div>
                    }
                    @if (profile.ShowRate)
                    {
                        <div>
                            <label asp-for="Input.Rate" class="valora-label">@profile.RateLabel</label>
                            <input asp-for="Input.Rate" class="valora-input" inputmode="decimal" />
                        </div>
                    }
                    @if (profile.ShowHours)
                    {
                        <div>
                            <label asp-for="Input.Hours" class="valora-label">@profile.HoursLabel</label>
                            <input asp-for="Input.Hours" class="valora-input" inputmode="decimal" />
                        </div>
                    }
                    @if (profile.ShowDependents)
                    {
                        <div>
                            <label asp-for="Input.Dependents" class="valora-label">@profile.DependentsLabel</label>
                            <input asp-for="Input.Dependents" class="valora-input" inputmode="numeric" />
                        </div>
                    }
                    @if (profile.ShowTransportDiscount)
                    {
                        <div style="grid-column: 1 / -1;">
                            <label asp-for="Input.TransportDiscount" class="valora-label">@profile.TransportDiscountLabel</label>
                            <input asp-for="Input.TransportDiscount" class="valora-input" inputmode="decimal" />
                        </div>
                    }
                    @if (profile.ShowTerminationReason)
                    {
                        <div style="grid-column: 1 / -1;">
                            <label asp-for="Input.TerminationReason" class="valora-label">@profile.TerminationReasonLabel</label>
                            <select asp-for="Input.TerminationReason" class="valora-input"
                                    asp-items="Html.GetEnumSelectList<MeuValorLiquido.Modules.Calculators.TerminationReason>()">
                            </select>
                            <p class="valora-helper">Escolha se você foi demitido pela empresa ou pediu demissão.</p>
                        </div>
                    }
                </div>
                <button class="valora-btn valora-btn-primary" type="submit">Calcular agora</button>
            </form>

            <div class="valora-disclaimer">
                <span class="material-symbols-outlined">warning</span>
                <p style="margin: 0;">Os resultados são estimativas educativas baseados nas tabelas vigentes. Consulte seu RH ou contador para valores oficiais.</p>
            </div>

            <section class="valora-card">
                <h2 class="valora-h3">Como usar esta calculadora</h2>
                <p class="valora-text-muted valora-text-sm" style="margin: 0;">@(Model.Definition.EducationalContent ?? "Preencha os campos indicados e use o resultado como estimativa educativa.")</p>
            </section>
        </div>

        <aside class="valora-calc-sidebar valora-stack-md">
            @if (Model.Result is not null)
            {
                <section class="valora-result-panel" aria-live="polite">
                    <h2 class="valora-h3" style="color: inherit; margin-bottom: 1rem;">Extrato estimado</h2>
                    <div class="valora-result-line">
                        <span>Valor bruto/base</span>
                        <strong>@Model.Result.GrossAmount</strong>
                    </div>
                    @foreach (var item in Model.Result.LineItems)
                    {
                        <div class="valora-result-line @(item.Type == CalculationLineType.Discount ? "discount" : "")">
                            <span>@item.Label</span>
                            <strong>@(item.Type == CalculationLineType.Discount ? "-" : "") @item.Amount</strong>
                        </div>
                    }
                    <div class="valora-result-total">
                        <span class="valora-result-total-label">VALOR LÍQUIDO ESTIMADO</span>
                        <span class="valora-result-total-value">@Model.Result.EstimatedNetAmount</span>
                    </div>
                    <p class="valora-text-sm" style="margin: 1rem 0 0; opacity: 0.9;">@Model.Result.Explanation</p>
                </section>
                <div class="valora-disclaimer">
                    <span class="material-symbols-outlined">info</span>
                    <p style="margin: 0;">@Model.Result.LegalDisclaimer</p>
                </div>
            }
            else
            {
                <section class="valora-result-panel" style="opacity: 0.85;">
                    <h2 class="valora-h3" style="color: inherit; margin-bottom: 0.5rem;">Seu resultado aparece aqui</h2>
                    <p class="valora-text-sm" style="margin: 0; opacity: 0.9;">Preencha o formulário e clique em Calcular para ver o extrato estimado.</p>
                </section>
            }

            @if (Model.BottomAdSlot is not null)
            {
                <partial name="Shared/_AdSlot" model="Model.BottomAdSlot" />
            }
        </aside>
    </div>

    <section class="valora-faq valora-section">
        <h2 class="valora-h2">Perguntas frequentes</h2>
        @foreach (var faq in Model.Definition.FaqItems)
        {
            <details>
                <summary>
                    @faq.Question
                    <span class="material-symbols-outlined">expand_more</span>
                </summary>
                <p class="faq-body">@faq.Answer</p>
            </details>
        }
    </section>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
