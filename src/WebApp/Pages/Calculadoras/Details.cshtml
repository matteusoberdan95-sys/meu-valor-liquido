@page "/calculadoras/{slug}"
@model MeuValorLiquido.WebApp.Pages.Calculadoras.DetailsModel
@{
    ViewData["Title"] = Model.Definition?.SeoTitle ?? "Calculadora";
    ViewData["Description"] = Model.Definition?.SeoDescription ?? "Calculadora do Meu Valor Líquido.";
    var profile = Model.FieldProfile;
}

@if (Model.Definition is null)
{
    <h1>Calculadora não encontrada</h1>
    <p>Confira a lista de calculadoras disponíveis.</p>
    <a asp-page="/Calculadoras/Index">Voltar para calculadoras</a>
}
else
{
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="/Index">Início</a></li>
            <li class="breadcrumb-item"><a asp-page="/Calculadoras/Index">Calculadoras</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Definition.Name</li>
        </ol>
    </nav>

    <h1>@Model.Definition.Name</h1>
    <p class="lead">@Model.Definition.Summary</p>

    @if (Model.TopAdSlot is not null)
    {
        <partial name="Shared/_AdSlot" model="Model.TopAdSlot" />
    }

    <form method="post" class="card card-body mb-4" asp-route-slug="@Model.Definition.Slug">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="row g-3">
            @if (profile.ShowAmount)
            {
                <div class="col-md-6">
                    <label asp-for="Input.Amount" class="form-label">@profile.AmountLabel</label>
                    <input asp-for="Input.Amount" class="form-control" inputmode="decimal" />
                    <span asp-validation-for="Input.Amount" class="text-danger"></span>
                </div>
            }
            @if (profile.ShowSecondaryAmount)
            {
                <div class="col-md-6">
                    <label asp-for="Input.SecondaryAmount" class="form-label">@profile.SecondaryAmountLabel</label>
                    <input asp-for="Input.SecondaryAmount" class="form-control" inputmode="decimal" />
                </div>
            }
            @if (profile.ShowMonths)
            {
                <div class="col-md-4">
                    <label asp-for="Input.Months" class="form-label">@profile.MonthsLabel</label>
                    <input asp-for="Input.Months" class="form-control" inputmode="numeric" />
                </div>
            }
            @if (profile.ShowRate)
            {
                <div class="col-md-4">
                    <label asp-for="Input.Rate" class="form-label">@profile.RateLabel</label>
                    <input asp-for="Input.Rate" class="form-control" inputmode="decimal" />
                </div>
            }
            @if (profile.ShowHours)
            {
                <div class="col-md-4">
                    <label asp-for="Input.Hours" class="form-label">@profile.HoursLabel</label>
                    <input asp-for="Input.Hours" class="form-control" inputmode="decimal" />
                </div>
            }
            @if (profile.ShowDependents)
            {
                <div class="col-md-4">
                    <label asp-for="Input.Dependents" class="form-label">@profile.DependentsLabel</label>
                    <input asp-for="Input.Dependents" class="form-control" inputmode="numeric" />
                </div>
            }
            @if (profile.ShowTransportDiscount)
            {
                <div class="col-md-8">
                    <label asp-for="Input.TransportDiscount" class="form-label">@profile.TransportDiscountLabel</label>
                    <input asp-for="Input.TransportDiscount" class="form-control" inputmode="decimal" />
                </div>
            }
        </div>
        <button class="btn btn-primary mt-3" type="submit">Calcular</button>
    </form>

    @if (Model.Result is not null)
    {
        <section class="card mb-4">
            <div class="card-body">
                <h2 class="h4">Resultado em formato de extrato</h2>
                <p><strong>Valor bruto/base:</strong> @Model.Result.GrossAmount</p>
                <h3 class="h5">Detalhamento</h3>
                <ul class="list-group mb-3">
                    @foreach (var item in Model.Result.LineItems)
                    {
                        <li class="list-group-item d-flex justify-content-between">
                            <span>@item.Label</span>
                            <strong>@(item.Type == CalculationLineType.Discount ? "-" : "") @item.Amount</strong>
                        </li>
                    }
                </ul>
                <p class="fs-4"><strong>Valor líquido/resultado estimado:</strong> @Model.Result.EstimatedNetAmount</p>
                <p>@Model.Result.Explanation</p>
                <p class="alert alert-warning">@Model.Result.LegalDisclaimer</p>
            </div>
        </section>
    }

    @if (Model.BottomAdSlot is not null)
    {
        <partial name="Shared/_AdSlot" model="Model.BottomAdSlot" />
    }

    <section class="mb-4">
        <h2>Perguntas frequentes</h2>
        @foreach (var faq in Model.Definition.FaqItems)
        {
            <details class="mb-2">
                <summary>@faq.Question</summary>
                <p>@faq.Answer</p>
            </details>
        }
    </section>

    <section>
        <h2>Como usar esta calculadora</h2>
        <p>@(Model.Definition.EducationalContent ?? "Preencha os campos indicados e use o resultado como estimativa educativa.")</p>
    </section>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
