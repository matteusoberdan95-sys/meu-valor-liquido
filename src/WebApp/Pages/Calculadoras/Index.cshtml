@page "/calculadoras"
@model MeuValorLiquido.WebApp.Pages.Calculadoras.IndexModel
@{
    ViewData["Title"] = "Calculadoras";
    ViewData["Description"] = "Escolha uma calculadora trabalhista, fiscal ou financeira.";
    ViewData["CanonicalPath"] = "/calculadoras";
}

<h1>Calculadoras</h1>
<p class="lead">Estime descontos, líquidos, juros ou parcelas. Os resultados são educativos e não substituem conferência profissional.</p>

<div class="mvl-filter-pills mb-4 d-flex flex-wrap gap-2">
    <a class="btn btn-sm @(string.IsNullOrEmpty(Model.Category) ? "btn-primary active" : "btn-outline-secondary")"
       asp-page="/Calculadoras/Index">Todas</a>
    @foreach (var category in Model.Categories)
    {
        <a class="btn btn-sm @(Model.Category == category ? "btn-primary active" : "btn-outline-secondary")"
           asp-page="/Calculadoras/Index" asp-route-categoria="@category">@category</a>
    }
</div>

<div class="row g-3">
    @foreach (var calculator in Model.Calculators)
    {
        <article class="col-md-6 col-lg-4">
            <div class="card mvl-card-calculator">
                <div class="card-body d-flex flex-column">
                    <partial name="Shared/_CalculatorCategoryBadge" model="calculator.Category" />
                    <h2 class="h5 mt-2">@calculator.Name</h2>
                    <p class="text-muted flex-grow-1">@calculator.Summary</p>
                    <a class="btn btn-primary mvl-btn-primary mt-2 align-self-start" asp-page="/Calculadoras/Details" asp-route-slug="@calculator.Slug">Calcular</a>
                </div>
            </div>
        </article>
    }
</div>

@if (Model.Calculators.Count == 0)
{
    <p class="text-muted">Nenhuma calculadora encontrada nesta categoria.</p>
}
