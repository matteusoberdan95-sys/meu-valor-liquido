@page "/calculadoras"
@model MeuValorLiquido.WebApp.Pages.Calculadoras.IndexModel
@{
    ViewData["Title"] = "Central de Calculadoras";
    ViewData["Description"] = "Simuladores trabalhistas, fiscais e financeiros atualizados com as regras vigentes.";
    ViewData["CanonicalPath"] = "/calculadoras";
    ViewData["BottomNavTab"] = "calc";
    var showFullHub = string.IsNullOrWhiteSpace(Model.Category)
        && string.IsNullOrWhiteSpace(Model.Query)
        && Model.FeaturedCalculator is not null;
    var mobileSecondary = showFullHub
        ? Model.Calculators.Where(c => Model.PopularCalculators.All(p => !p.Slug.Equals(c.Slug, StringComparison.OrdinalIgnoreCase))).ToList()
        : Model.Calculators.ToList();
}

<div class="valora-stitch-calc-hub">
    <form class="valora-stitch-calc-search" method="get" asp-page="/Calculadoras/Index" role="search">
        <span class="material-symbols-outlined valora-stitch-calc-search-icon" aria-hidden="true">search</span>
        <input type="search"
               name="q"
               value="@Model.Query"
               class="valora-stitch-calc-search-input"
               placeholder="Qual cálculo você precisa fazer hoje?"
               aria-label="Buscar calculadoras" />
        @if (!string.IsNullOrWhiteSpace(Model.Category))
        {
            <input type="hidden" name="categoria" value="@Model.Category" />
        }
    </form>

    <div class="valora-stitch-calc-filters valora-stitch-calc-filters--scroll" aria-label="Filtrar por categoria">
        <a class="valora-stitch-filter-chip @(string.IsNullOrEmpty(Model.Category) ? "active" : "")"
           asp-page="/Calculadoras/Index" asp-route-q="@Model.Query">
            Todas
        </a>
        @foreach (var category in Model.Categories)
        {
            <a class="valora-stitch-filter-chip @(Model.Category == category ? "active" : "")"
               asp-page="/Calculadoras/Index" asp-route-categoria="@category" asp-route-q="@Model.Query">
                @category
            </a>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Query))
    {
        <p class="valora-stitch-calc-query">
            Resultados para <strong>@Model.Query</strong> — @Model.Calculators.Count calculadora(s)
        </p>
    }

    @if (Model.Calculators.Count == 0)
    {
        <p class="valora-text-muted">Nenhuma calculadora encontrada. <a asp-page="/Calculadoras/Index">Ver todas</a></p>
    }
    else
    {
        <div class="valora-stitch-calc-mobile">
            @if (showFullHub && Model.PopularCalculators.Count > 0)
            {
                <section class="valora-stitch-calc-mobile-section">
                    <h2 class="valora-stitch-calc-section-label">Populares</h2>
                    <div class="valora-stitch-calc-row-list">
                        @foreach (var calculator in Model.PopularCalculators)
                        {
                            <partial name="Shared/_CalculadoraHubRowCard" model="calculator" />
                        }
                    </div>
                </section>
            }

            @if (!showFullHub || mobileSecondary.Count > 0)
            {
                <section class="valora-stitch-calc-mobile-section">
                    @if (showFullHub)
                    {
                        <h2 class="valora-stitch-calc-section-label">Todas as ferramentas</h2>
                    }
                    <div class="valora-stitch-calc-row-list">
                        @foreach (var calculator in showFullHub ? mobileSecondary : Model.Calculators)
                        {
                            <partial name="Shared/_CalculadoraHubRowCard" model="calculator" />
                        }
                    </div>
                </section>
            }

            <section class="valora-stitch-calc-mobile-cta">
                <div class="valora-stitch-calc-mobile-cta-inner">
                    <h2 class="valora-stitch-calc-mobile-cta-title">Não encontrou?</h2>
                    <p class="valora-stitch-calc-mobile-cta-text">Sugira uma nova calculadora e ajude a comunidade a crescer.</p>
                    <a class="valora-stitch-btn valora-stitch-btn--primary valora-stitch-btn--inline" asp-page="/Contato">Sugerir calculadora</a>
                </div>
                <span class="material-symbols-outlined valora-stitch-calc-mobile-cta-icon" aria-hidden="true">add_task</span>
            </section>
        </div>

        <div class="valora-stitch-calc-desktop">
            <section class="valora-stitch-calc-hero">
                <div class="valora-stitch-calc-hero-copy">
                    <h1 class="valora-stitch-calc-title">Central de Calculadoras</h1>
                    <p class="valora-stitch-calc-lead">
                        Ferramentas precisas para planejar sua vida financeira e entender seu valor real no mercado brasileiro.
                    </p>
                </div>
            </section>

            <div class="valora-stitch-calc-layout">
                <aside class="valora-stitch-calc-sidebar" aria-label="Categorias">
                    <div class="valora-stitch-calc-sidebar-card">
                        <h2 class="valora-stitch-calc-sidebar-title">Categorias</h2>
                        <ul class="valora-stitch-calc-sidebar-list">
                            <li>
                                <a class="valora-stitch-calc-sidebar-link @(string.IsNullOrEmpty(Model.Category) ? "active" : "")"
                                   asp-page="/Calculadoras/Index" asp-route-q="@Model.Query">
                                    <span>Todas</span>
                                    <span class="valora-stitch-calc-sidebar-count">@Model.TotalCount</span>
                                </a>
                            </li>
                            @foreach (var category in Model.Categories)
                            {
                                var count = Model.CategoryCounts.TryGetValue(category, out var categoryCount) ? categoryCount : 0;
                                <li>
                                    <a class="valora-stitch-calc-sidebar-link @(Model.Category == category ? "active" : "")"
                                       asp-page="/Calculadoras/Index" asp-route-categoria="@category" asp-route-q="@Model.Query">
                                        <span>@category</span>
                                        <span class="valora-stitch-calc-sidebar-count">@count</span>
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                    <div class="valora-stitch-calc-sidebar-promo">
                        <h3 class="valora-stitch-calc-sidebar-promo-title">Espaço do Especialista</h3>
                        <p class="valora-stitch-calc-sidebar-promo-text">Aprenda a otimizar seus cálculos com nosso guia de metodologia.</p>
                        <a class="valora-stitch-link" asp-page="/ComoCalculamos">
                            Ver metodologia
                            <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
                        </a>
                        <span class="material-symbols-outlined valora-stitch-calc-sidebar-promo-icon" aria-hidden="true">description</span>
                    </div>
                </aside>

                <div class="valora-stitch-calc-main">
                    @if (showFullHub)
                    {
                        <div class="valora-stitch-calc-bento">
                            <article class="valora-stitch-calc-featured">
                                <div class="valora-stitch-calc-featured-body">
                                    <div class="valora-stitch-calc-featured-main">
                                        <div class="valora-stitch-calc-featured-head">
                                            <div class="valora-bento-icon-box valora-bento-icon-box--trabalhista">
                                                <span class="material-symbols-outlined valora-stitch-bento-icon" aria-hidden="true">payments</span>
                                            </div>
                                            <span class="valora-stitch-calc-badge-popular">Mais utilizada</span>
                                        </div>
                                        <h2 class="valora-stitch-calc-featured-title">@Model.FeaturedCalculator!.Name</h2>
                                        <p class="valora-stitch-calc-featured-summary">@Model.FeaturedCalculator.Summary</p>
                                        <a class="valora-stitch-hub-card-cta valora-stitch-hub-card-cta--featured"
                                           asp-page="/Calculadoras/Details" asp-route-slug="@Model.FeaturedCalculator.Slug">
                                            <span>Acessar calculadora</span>
                                            <span class="material-symbols-outlined" aria-hidden="true">chevron_right</span>
                                        </a>
                                    </div>
                                </div>
                            </article>

                            @foreach (var calculator in Model.HubSecondaryCalculators)
                            {
                                <partial name="Shared/_CalculadoraHubCard" model="calculator" />
                            }

                            <div class="valora-stitch-calc-cta-card">
                                <span class="material-symbols-outlined valora-stitch-calc-cta-card-icon" aria-hidden="true">rocket_launch</span>
                                <h3 class="valora-stitch-calc-cta-card-title">Precisa de mais?</h3>
                                <p class="valora-stitch-calc-cta-card-text">Fale conosco para sugerir novas ferramentas ou tirar dúvidas sobre os cálculos.</p>
                                <a class="valora-stitch-btn valora-stitch-btn--primary valora-stitch-btn--inline" asp-page="/Contato">Fale conosco</a>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="valora-stitch-calc-list">
                            @foreach (var calculator in Model.Calculators)
                            {
                                <partial name="Shared/_CalculadoraHubCard" model="calculator" />
                            }
                        </div>
                    }

                    <div class="valora-stitch-calc-disclaimer">
                        <span class="material-symbols-outlined" aria-hidden="true">info</span>
                        <p>
                            <strong>Isenção de responsabilidade:</strong> Os cálculos têm caráter informativo e educacional. Para decisões críticas, consulte um contador ou o RH da sua organização.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (showFullHub)
    {
        <partial name="Shared/_ThematicJourneyCards" view-data="@(new ViewDataDictionary(ViewData) { { "ThematicJourneyCompact", true }, { "ThematicJourneySectionId", "jornadas-tematicas-calc" } })" />

        <partial name="Shared/_UtilityToolsCards" />

        <section class="valora-stitch-calc-premium-banner" aria-label="Destaque CLT vs PJ">
            <div class="valora-stitch-calc-premium-banner-glow" aria-hidden="true"></div>
            <div class="valora-stitch-calc-premium-banner-content">
                <div class="valora-stitch-calc-premium-banner-copy">
                    <span class="valora-stitch-calc-premium-badge">Mais usada esta semana</span>
                    <h2 class="valora-stitch-calc-premium-title">Calculadora CLT vs PJ Premium</h2>
                    <p class="valora-stitch-calc-premium-text">
                        Analise benefícios, férias, 13º e tributação em ambos os regimes para decidir com base no líquido real.
                    </p>
                    <a class="valora-stitch-btn valora-stitch-btn--primary valora-stitch-calc-premium-btn"
                       asp-page="/Calculadoras/Details"
                       asp-route-slug="pj-vs-clt">
                        Comparar agora
                    </a>
                </div>
                <div class="valora-stitch-calc-premium-visual" aria-hidden="true">
                    <span class="material-symbols-outlined valora-icon-filled">insights</span>
                </div>
            </div>
        </section>
    }
</div>
