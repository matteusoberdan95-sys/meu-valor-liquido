@page "/calculadoras"
@model MeuValorLiquido.WebApp.Pages.Calculadoras.IndexModel
@{
    ViewData["Title"] = "Central de Ferramentas e Cálculos";
    ViewData["Description"] = "Simuladores trabalhistas, fiscais e financeiros atualizados com as regras vigentes.";
    ViewData["CanonicalPath"] = "/calculadoras";
    ViewData["BottomNavTab"] = "calc";
    var showFullHub = string.IsNullOrWhiteSpace(Model.Category)
        && string.IsNullOrWhiteSpace(Model.Query)
        && Model.FeaturedCalculator is not null;
}

<div class="valora-stitch-calc-hub">
    <section class="valora-stitch-calc-hero">
        <div class="valora-stitch-calc-hero-copy">
            <span class="valora-stitch-pill valora-stitch-pill--trabalhista">Ferramentas profissionais</span>
            <h1 class="valora-stitch-calc-title">Central de Ferramentas e Cálculos</h1>
            <p class="valora-stitch-calc-lead">
                Planeje sua carreira com precisão. Simuladores completos atualizados com as regras vigentes para CLT, PJ, MEI e muito mais.
            </p>
        </div>
        <div class="valora-stitch-calc-hero-visual" aria-hidden="true">
            <span class="material-symbols-outlined">laptop_mac</span>
        </div>
    </section>

    <div class="valora-stitch-calc-filters" aria-label="Filtrar por categoria">
        <a class="valora-stitch-filter-chip @(string.IsNullOrEmpty(Model.Category) ? "active" : "")"
           asp-page="/Calculadoras/Index" asp-route-q="@Model.Query">
            Todas
        </a>
        @foreach (var category in Model.Categories)
        {
            <a class="valora-stitch-filter-chip @(Model.Category == category ? "active" : "")"
               asp-page="/Calculadoras/Index" asp-route-categoria="@category" asp-route-q="@Model.Query">
                @category
            </a>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Query))
    {
        <p class="valora-stitch-calc-query">
            Resultados para <strong>@Model.Query</strong> — @Model.Calculators.Count calculadora(s)
        </p>
    }

    @if (Model.Calculators.Count == 0)
    {
        <p class="valora-text-muted">Nenhuma calculadora encontrada. <a asp-page="/Calculadoras/Index">Ver todas</a></p>
    }
    else if (showFullHub)
    {
        <div class="valora-stitch-calc-bento">
            <article class="valora-stitch-calc-featured">
                <div class="valora-stitch-calc-featured-accent" aria-hidden="true"></div>
                <div class="valora-stitch-calc-featured-body">
                    <div class="valora-stitch-calc-featured-main">
                        <div class="valora-stitch-calc-featured-head">
                            <span class="material-symbols-outlined valora-bento-icon--trabalhista" aria-hidden="true">payments</span>
                            <span class="valora-stitch-calc-badge-popular">Mais utilizada</span>
                        </div>
                        <h2 class="valora-stitch-calc-featured-title">@Model.FeaturedCalculator!.Name</h2>
                        <p class="valora-stitch-calc-featured-summary">@Model.FeaturedCalculator.Summary</p>
                        <ul class="valora-stitch-calc-checks">
                            <li><span class="material-symbols-outlined" aria-hidden="true">check_circle</span> INSS</li>
                            <li><span class="material-symbols-outlined" aria-hidden="true">check_circle</span> IRRF</li>
                            <li><span class="material-symbols-outlined" aria-hidden="true">check_circle</span> FGTS</li>
                            <li><span class="material-symbols-outlined" aria-hidden="true">check_circle</span> VT/VR</li>
                        </ul>
                        <a class="valora-stitch-btn valora-stitch-btn--primary valora-stitch-btn--inline"
                           asp-page="/Calculadoras/Details" asp-route-slug="@Model.FeaturedCalculator.Slug">
                            Acessar calculadora
                            <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
                        </a>
                    </div>
                    <span class="material-symbols-outlined valora-stitch-calc-featured-watermark" aria-hidden="true">calculate</span>
                </div>
            </article>

            <div class="valora-stitch-calc-ad" role="complementary" aria-label="Espaço publicitário">
                <span class="valora-stitch-ad-label">Espaço publicitário</span>
                <div class="valora-stitch-calc-ad-body">
                    <span class="material-symbols-outlined" aria-hidden="true">ads_click</span>
                </div>
                <p class="valora-stitch-calc-ad-note">Apoie o desenvolvimento de ferramentas gratuitas.</p>
            </div>

            @foreach (var calculator in Model.HubSecondaryCalculators)
            {
                <partial name="Shared/_CalculadoraHubCard" model="calculator" />
            }
        </div>

        <div class="valora-stitch-calc-disclaimer">
            <span class="material-symbols-outlined" aria-hidden="true">info</span>
            <p>
                <strong>Isenção de responsabilidade:</strong> Os cálculos têm caráter informativo e educacional. Para decisões críticas, consulte um contador ou o RH da sua organização.
            </p>
        </div>
    }
    else
    {
        <div class="valora-stitch-calc-list">
            @foreach (var calculator in Model.Calculators)
            {
                <partial name="Shared/_CalculadoraHubCard" model="calculator" />
            }
        </div>
    }
</div>
