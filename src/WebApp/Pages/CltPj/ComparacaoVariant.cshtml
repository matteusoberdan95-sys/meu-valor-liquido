@page "/clt-pj/{valor:int}/{variant}"
@model MeuValorLiquido.WebApp.Pages.CltPj.ComparacaoVariantModel
@{
    ViewData["Title"] = Model.PageContent.Title;
    ViewData["Description"] = Model.PageContent.Description;
    ViewData["CanonicalPath"] = CltPjBandCatalog.SlugPath(Model.PageContent.CltGross, Model.PageContent.Dependents);
}

@section Head {
    <partial name="Shared/_JsonLdFaq" model="Model.FaqSchemaItems" />
    <partial name="Shared/_JsonLdBreadcrumb" model="SeoMetadataHelper.CltPjBandBreadcrumbs(Model.PageContent.CltGross, Model.PageContent.Dependents)" />
}

<partial name="CltPj/_ComparacaoContent" model="Model" />
