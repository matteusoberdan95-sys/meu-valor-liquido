@model MeuValorLiquido.WebApp.Infrastructure.CalculatorResultPanelViewModel

<section class="valora-result-panel" aria-live="polite" data-result-view-root>
    @if (Model.ShowSimpleExplanation)
    {
    <div class="valora-result-view-toggle" role="tablist" aria-label="Formato do resultado">
        <button type="button"
                class="valora-result-view-btn"
                role="tab"
                aria-selected="true"
                aria-controls="result-panel-extract"
                data-result-view="extract">
            <span class="material-symbols-outlined" style="font-size: 1.125rem;">receipt_long</span>
            Extrato
        </button>
        <button type="button"
                class="valora-result-view-btn"
                role="tab"
                aria-selected="false"
                aria-controls="result-panel-simple"
                data-result-view="simple">
            <span class="material-symbols-outlined" style="font-size: 1.125rem;">school</span>
            Explicação simples
        </button>
    </div>
    }

    <div id="result-panel-extract" class="valora-result-view-panel" data-result-panel="extract" role="tabpanel">
        <h2 class="valora-h3" style="color: inherit; margin: 1rem 0;">@(Model.TerminationSummary is not null ? "Resultado do cálculo" : "Extrato estimado")</h2>
        @if (Model.CalculatorSlug.Equals("rescisao-clt", StringComparison.OrdinalIgnoreCase))
        {
            <div class="valora-result-line">
                <span>Tipo de desligamento</span>
                <strong>@Model.Input.TerminationReason.GetDisplayName()</strong>
            </div>
        }

        @if (Model.TerminationSummary is not null)
        {
            var summary = Model.TerminationSummary;
            var verbasLabel = Model.CalculatorSlug switch
            {
                "salario-liquido" => "Salário bruto",
                "ferias" or "decimo-terceiro" => "Verbas",
                _ => "Verbas rescisórias"
            };
            <div class="valora-result-summary-grid">
                <div class="valora-result-line">
                    <span>@verbasLabel</span>
                    <strong>@Money.From(summary.VerbasTotal)</strong>
                </div>
                <div class="valora-result-line discount">
                    <span>Descontos</span>
                    <strong>- @Money.From(summary.DescontosTotal)</strong>
                </div>
                @if (Model.CalculatorSlug.Equals("rescisao-clt", StringComparison.OrdinalIgnoreCase))
                {
                <div class="valora-result-line">
                    <span>Total FGTS (informativo)</span>
                    <strong>@Money.From(summary.FgtsTotal)</strong>
                </div>
                <div class="valora-stitch-rescisao-fgts-callout">
                    <span class="material-symbols-outlined" aria-hidden="true">savings</span>
                    <p>Em demissões sem justa causa, você pode ter direito ao saque do saldo do FGTS mais multa rescisória (40% ou 20% no acordo). Valores informativos — confirme com o RH ou Caixa.</p>
                </div>
                }
            </div>
            <details class="valora-result-details" style="margin: 1rem 0;">
                <summary class="valora-text-sm" style="cursor: pointer; font-weight: 600;">Detalhes do cálculo</summary>
                <div style="margin-top: 0.75rem;">
                    @foreach (var item in Model.Result.LineItems)
                    {
                        <div class="valora-result-line @(item.Type == CalculationLineType.Discount ? "discount" : "")">
                            <span>@item.Label</span>
                            @if (!string.IsNullOrEmpty(item.DisplayText))
                            {
                                <strong>@item.DisplayText</strong>
                            }
                            else
                            {
                                <strong>@(item.Type == CalculationLineType.Discount ? "-" : "") @item.Amount</strong>
                            }
                        </div>
                    }
                </div>
            </details>
        }
        else
        {
            <div class="valora-result-line">
                <span>@(Model.CalculatorSlug.Equals("proposta-salarial", StringComparison.OrdinalIgnoreCase) ? "Salário bruto proposto" : Model.CalculatorSlug.Equals("pj-vs-clt", StringComparison.OrdinalIgnoreCase) ? "Referência (maior valor)" : "Total bruto das verbas")</span>
                <strong>@Model.Result.GrossAmount</strong>
            </div>
            @foreach (var item in Model.Result.LineItems)
            {
                <div class="valora-result-line @(item.Type == CalculationLineType.Discount ? "discount" : "")">
                    <span>@item.Label</span>
                    @if (!string.IsNullOrEmpty(item.DisplayText))
                    {
                        <strong>@item.DisplayText</strong>
                    }
                    else
                    {
                        <strong>@(item.Type == CalculationLineType.Discount ? "-" : "") @item.Amount</strong>
                    }
                </div>
            }
        }

        @{
            var meiDisqualified = Model.CalculatorSlug.Equals("simulador-mei", StringComparison.OrdinalIgnoreCase)
                && Model.Result.LineItems.Any(i => i.DisplayText == "Desenquadrado do MEI");
        }
        <div class="valora-result-total">
            @if (meiDisqualified)
            {
                <span class="valora-result-total-label">SITUAÇÃO MEI</span>
                <span class="valora-result-total-value" style="font-size: 1.35rem;">Desenquadrado</span>
            }
            else
            {
                <span class="valora-result-total-label">@(Model.CalculatorSlug.Equals("proposta-salarial", StringComparison.OrdinalIgnoreCase) ? "LÍQUIDO PROPOSTO ESTIMADO" : Model.CalculatorSlug.Equals("pj-vs-clt", StringComparison.OrdinalIgnoreCase) ? "MELHOR LÍQUIDO NO CENÁRIO" : "VALOR LÍQUIDO ESTIMADO")</span>
                <span class="valora-result-total-value valora-monetary-display">@Model.Result.EstimatedNetAmount</span>
            }
        </div>
        <p class="valora-text-sm" style="margin: 1rem 0 0; opacity: 0.9;">@Model.Result.Explanation</p>
    </div>

    @if (Model.ShowSimpleExplanation)
    {
    <div id="result-panel-simple" class="valora-result-view-panel" data-result-panel="simple" role="tabpanel" hidden>
        <h2 class="valora-h3" style="color: inherit; margin: 1rem 0;">Entenda em passos</h2>
        <p class="valora-text-sm" style="margin: 0 0 1rem; opacity: 0.9;">
            Mesma estimativa do extrato, em linguagem direta para quem não é de RH ou contabilidade.
        </p>
        <ol class="valora-simple-steps">
            @foreach (var step in Model.Explanation.Simple.Steps)
            {
                <li class="valora-simple-step">
                    <div class="valora-simple-step-header">
                        <span class="valora-simple-step-order">@step.Order</span>
                        <strong class="valora-simple-step-title">@step.Title</strong>
                        @if (!string.IsNullOrEmpty(step.Highlight))
                        {
                            <span class="valora-simple-step-highlight">@step.Highlight</span>
                        }
                    </div>
                    <p class="valora-simple-step-body">@step.Body</p>
                </li>
            }
        </ol>
    </div>
    }
</section>

@if (Model.ShowSimpleExplanation && Model.Explanation.RelatedLinks.Count > 0)
{
    <section class="valora-related-tools" aria-label="Ferramentas relacionadas">
        <h3 class="valora-h3" style="font-size: 1rem; margin-bottom: 0.75rem;">Continue explorando</h3>
        <ul class="valora-related-tools-list">
            @foreach (var link in Model.Explanation.RelatedLinks)
            {
                <li>
                    <a class="valora-related-tool-link" href="@link.Url">
                        <span class="valora-related-tool-name">@link.Name</span>
                        <span class="valora-related-tool-teaser">@link.Teaser</span>
                    </a>
                </li>
            }
        </ul>
    </section>
}
