@inject Microsoft.Extensions.Options.IOptions<MeuValorLiquido.Modules.Ads.AdsOptions> AdsOptions
@{
    var adsActive = AdsOptions.Value.IsActive;
    var adsScriptEnabled = adsActive;
    var publisherId = AdsOptions.Value.PublisherId ?? string.Empty;
}
<div class="valora-cookie-consent"
     data-cookie-consent
     data-consent-version="2"
     data-policy-version="2026-07-17"
     data-ads-slots-enabled="@(adsActive ? "true" : "false")"
     data-ads-script-enabled="@(adsScriptEnabled ? "true" : "false")"
     data-ads-publisher="@publisherId"
     hidden
     role="dialog"
     aria-live="polite"
     aria-label="Consentimento de cookies">
    <div class="valora-cookie-consent-content">
        <button class="valora-cookie-consent-close" type="button" aria-label="Fechar aviso de cookies" data-cookie-consent-close>
            <span class="material-symbols-outlined" aria-hidden="true">close</span>
        </button>

        <h2 class="valora-cookie-consent-title">Escolha como seus dados podem ser usados</h2>
        <p class="valora-cookie-consent-text">
            Cookies essenciais mantêm o site seguro. Com sua permissão, também podemos guardar preferências,
            medir interações e carregar publicidade do Google. Nenhuma categoria opcional vem marcada.
        </p>

        <div class="valora-cookie-consent-actions">
            <button type="button" class="valora-cookie-consent-btn valora-cookie-consent-btn--primary" data-cookie-consent-accept>
                Aceitar todos
            </button>
            <button type="button" class="valora-cookie-consent-btn valora-cookie-consent-btn--secondary" data-cookie-consent-essential>
                Rejeitar todos
            </button>
            <button type="button" class="valora-cookie-consent-btn valora-cookie-consent-btn--secondary" data-cookie-consent-customize aria-expanded="false" aria-controls="cookie-consent-preferences">
                Personalizar
            </button>
        </div>

        <div class="valora-cookie-consent-preferences" id="cookie-consent-preferences" data-cookie-consent-preferences hidden>
            <label class="valora-cookie-consent-option">
                <input type="checkbox" checked disabled />
                <span>
                    <strong>Cookies essenciais</strong>
                    <small>Necessários para segurança, formulários e registro da sua escolha.</small>
                </span>
            </label>
            <label class="valora-cookie-consent-option">
                <input type="checkbox" data-cookie-consent-analytics />
                <span>
                    <strong>Analytics</strong>
                    <small>Permite medir interações voluntárias, como salvar ou compartilhar uma simulação.</small>
                </span>
            </label>
            <label class="valora-cookie-consent-option">
                <input type="checkbox" data-cookie-consent-personalization />
                <span>
                    <strong>Personalização</strong>
                    <small>Permite salvar simulações e checklists no armazenamento local deste navegador.</small>
                </span>
            </label>
            <label class="valora-cookie-consent-option">
                <input type="checkbox" data-cookie-consent-advertising />
                <span>
                    <strong>Publicidade</strong>
                    <small>@(adsScriptEnabled ? "Permite carregar o Google AdSense e medir anúncios." : "Registra sua preferência; nenhum script de publicidade está configurado no momento.")</small>
                </span>
            </label>
            <button type="button" class="valora-cookie-consent-save" data-cookie-consent-save>
                Salvar preferências
            </button>
        </div>

        <div class="valora-cookie-consent-links">
            <a asp-page="/PoliticaDeCookies">Politica de cookies</a>
            <a asp-page="/PoliticaDePrivacidade">Politica de privacidade</a>
        </div>
    </div>
</div>
