@model CalculatorDefinition

<a class="valora-stitch-hub-card" asp-page="/Calculadoras/Details" asp-route-slug="@Model.Slug">
    <div class="valora-stitch-hub-card-top">
        <span class="valora-stitch-hub-card-category @CalculatorUiHelper.GetHubCategoryBadgeClass(Model.Category)">
            @Model.Category
        </span>
        <span class="material-symbols-outlined valora-stitch-hub-card-glyph" aria-hidden="true">@CalculatorUiHelper.GetIcon(Model.Slug)</span>
    </div>
    <h3 class="valora-stitch-hub-card-title">@Model.Name</h3>
    <p class="valora-stitch-hub-card-summary">@Model.Summary</p>
    <div class="valora-stitch-hub-card-cta">
        <span>Acessar calculadora</span>
        <span class="material-symbols-outlined" aria-hidden="true">chevron_right</span>
    </div>
</a>
