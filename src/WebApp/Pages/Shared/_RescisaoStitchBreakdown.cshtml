@model MeuValorLiquido.WebApp.Infrastructure.RescisaoStitchResultViewModel
@{
    var summary = Model.Summary;
}

<div class="valora-stitch-rescisao-breakdown valora-stack-md" aria-live="polite">
    <partial name="Shared/_CalculatorResultWarnings" model="Model.Warnings" />

    <section class="valora-stitch-rescisao-card">
        <div class="valora-stitch-rescisao-card-head">
            <div class="valora-stitch-rescisao-card-title-row">
                <span class="material-symbols-outlined" aria-hidden="true">payments</span>
                <h2 class="valora-stitch-rescisao-card-title">Verbas rescisórias</h2>
            </div>
            <span class="valora-stitch-rescisao-card-total valora-stitch-rescisao-card-total--credit">@Money.From(summary.VerbasTotal)</span>
        </div>
        <div class="valora-stitch-rescisao-line-cards">
            @foreach (var item in summary.Verbas)
            {
                <div class="valora-stitch-rescisao-line-card">
                    <div>
                        <p class="valora-stitch-rescisao-line-label">@item.Label</p>
                        @if (!string.IsNullOrWhiteSpace(item.DisplayText))
                        {
                            <p class="valora-stitch-rescisao-line-hint">@item.DisplayText</p>
                        }
                    </div>
                    <span class="valora-stitch-rescisao-line-value">@item.Amount</span>
                </div>
            }
        </div>
    </section>

    @if (summary.Descontos.Count > 0)
    {
        <section class="valora-stitch-rescisao-card">
            <div class="valora-stitch-rescisao-card-head">
                <div class="valora-stitch-rescisao-card-title-row">
                    <span class="material-symbols-outlined valora-stitch-rescisao-icon-error" aria-hidden="true">receipt_long</span>
                    <h2 class="valora-stitch-rescisao-card-title">Descontos</h2>
                </div>
                <span class="valora-stitch-rescisao-card-total valora-stitch-rescisao-card-total--debit">- @Money.From(summary.DescontosTotal)</span>
            </div>
            <ul class="valora-stitch-rescisao-discount-list">
                @foreach (var item in summary.Descontos)
                {
                    <li class="valora-stitch-rescisao-discount-row">
                        <span>@item.Label</span>
                        <span>- @item.Amount</span>
                    </li>
                }
            </ul>
        </section>
    }

    @if (summary.FgtsLines.Count > 0 || Model.FgtsBalanceCard is not null || Model.FgtsPenaltyCard is not null)
    {
        <section class="valora-stitch-rescisao-card">
            <div class="valora-stitch-rescisao-card-title-row valora-stitch-rescisao-card-title-row--solo">
                <span class="material-symbols-outlined valora-stitch-rescisao-icon-fiscal" aria-hidden="true">savings</span>
                <h2 class="valora-stitch-rescisao-card-title">FGTS e indenização</h2>
            </div>
            <div class="valora-stitch-rescisao-fgts-grid">
                @if (Model.FgtsBalanceCard is not null)
                {
                    <div class="valora-stitch-rescisao-fgts-stat">
                        <p class="valora-stitch-rescisao-fgts-stat-label">@Model.FgtsBalanceCard.Label</p>
                        <p class="valora-stitch-rescisao-fgts-stat-value">@Money.From(Model.FgtsBalanceCard.Amount)</p>
                    </div>
                }
                @if (Model.FgtsPenaltyCard is not null)
                {
                    <div class="valora-stitch-rescisao-fgts-stat valora-stitch-rescisao-fgts-stat--highlight">
                        <p class="valora-stitch-rescisao-fgts-stat-label">@Model.FgtsPenaltyCard.Label</p>
                        <p class="valora-stitch-rescisao-fgts-stat-value">@Money.From(Model.FgtsPenaltyCard.Amount)</p>
                    </div>
                }
            </div>
            <div class="valora-stitch-rescisao-fgts-callout">
                <span class="material-symbols-outlined" aria-hidden="true">info</span>
                <p>Em demissões sem justa causa, você pode ter direito ao saque do saldo do FGTS mais multa rescisória (40% ou 20% no acordo). Valores informativos — confirme com o RH ou Caixa.</p>
            </div>
        </section>
    }
</div>
