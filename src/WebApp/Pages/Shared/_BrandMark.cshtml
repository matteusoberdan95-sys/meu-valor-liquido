@{
    var brandMarkClass = ViewData["BrandMarkClass"]?.ToString() ?? "";
    var isFooter = brandMarkClass.Contains("footer", StringComparison.OrdinalIgnoreCase);
    var isCompact = brandMarkClass.Contains("compact", StringComparison.OrdinalIgnoreCase);
    var logoVariant = isFooter ? "stacked" : isCompact ? "icon" : "horizontal";
    var logoFile = $"logo-{logoVariant}.webp";
    var logoClass = $"valora-brand-logo valora-brand-logo--{logoVariant}";
}
<a class="valora-brand-mark @brandMarkClass" asp-page="/Index">
    <img class="@logoClass"
         src="~/images/brand/@logoFile" asp-append-version="true"
         alt="Meu Valor Líquido"
         width="@(isCompact ? 32 : isFooter ? 200 : 240)"
         height="@(isCompact ? 32 : isFooter ? 120 : 48)"
         decoding="async" />
</a>
