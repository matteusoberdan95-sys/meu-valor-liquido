@model IReadOnlyList<MeuValorLiquido.WebApp.Infrastructure.CalculatorResultWarning>
@if (Model.Count > 0)
{
    <div class="valora-result-warnings" aria-label="Avisos sobre o resultado">
        @foreach (var warning in Model)
        {
            <div class="valora-result-warning valora-result-warning--@warning.Severity">
                <span class="material-symbols-outlined" aria-hidden="true">@warning.Icon</span>
                <p>@warning.Message</p>
            </div>
        }
    </div>
}
