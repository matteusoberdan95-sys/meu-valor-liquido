<form method="post"
      asp-page="/Newsletter"
      class="valora-stitch-panel-newsletter-form"
      aria-label="Inscrever-se na newsletter">
    <label class="valora-sr-only" for="panel-newsletter-email">E-mail</label>
    <input id="panel-newsletter-email"
           name="Email"
           class="valora-stitch-panel-newsletter-input"
           type="email"
           placeholder="seu@email.com"
           autocomplete="email"
           required />
    <button class="valora-stitch-panel-newsletter-btn" type="submit">Inscrever-se</button>
</form>
