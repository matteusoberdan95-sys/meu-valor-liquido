@inject IConfiguration Configuration
@inject Microsoft.Extensions.Options.IOptions<MeuValorLiquido.Modules.Ads.AdsOptions> AdsOptions
@{
    var currentPath = Context.Request.Path.Value ?? "/";
    bool IsActive(string path) =>
        path == "/" ? currentPath == "/" : currentPath.StartsWith(path, StringComparison.OrdinalIgnoreCase);
    var hideBottomNav = ViewData["HideBottomNav"] as bool? == true;
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @{
        var title = ViewData["Title"]?.ToString() ?? "Meu Valor Líquido";
        var description = ViewData["Description"]?.ToString() ?? "Calculadoras trabalhistas, fiscais e financeiras para brasileiros.";
        var baseUrl = Configuration["Site:BaseUrl"]?.TrimEnd('/') ?? $"{Context.Request.Scheme}://{Context.Request.Host}";
        var canonicalPath = ViewData["CanonicalPath"]?.ToString() ?? Context.Request.Path.Value ?? "/";
        var canonicalUrl = SeoMetadataHelper.BuildCanonicalUrl(baseUrl, canonicalPath);
        var ogType = ViewData["OgType"]?.ToString() ?? "website";
        var robots = ViewData["Robots"]?.ToString() ?? SeoMetadataHelper.DefaultRobots;
        var ogImagePath = ViewData["OgImagePath"]?.ToString();
        var ogImageUrl = SeoMetadataHelper.BuildOgImageUrl(baseUrl, ogImagePath);
    }
    <meta name="robots" content="@robots" />
    <meta name="description" content="@description" />
    <link rel="canonical" href="@canonicalUrl" />
    <meta property="og:title" content="@title" />
    <meta property="og:description" content="@description" />
    <meta property="og:type" content="@ogType" />
    <meta property="og:url" content="@canonicalUrl" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="@SeoMetadataHelper.SiteName" />
    <meta property="og:image" content="@ogImageUrl" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@title" />
    <meta name="twitter:description" content="@description" />
    <meta name="twitter:image" content="@ogImageUrl" />
    <title>@title - Meu Valor Líquido</title>
    <link rel="icon" href="~/favicon.ico" sizes="any" />
    <link rel="preload" href="~/css/site.css" asp-append-version="true" as="style" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MeuValorLiquido.WebApp.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body class="valora-app@(hideBottomNav ? "" : " valora-has-bottom-nav")">
    <header class="valora-header valora-header--stitch">
        <div class="valora-container valora-header-inner">
            <partial name="Shared/_BrandMark" />
            <nav class="valora-nav-desktop" aria-label="Principal">
                <ul class="valora-nav">
                    <li><a class="@(currentPath == "/" ? "active" : "")" asp-page="/Index">Início</a></li>
                    <li><a class="@(IsActive("/calculadoras") ? "active" : "")" asp-page="/Calculadoras/Index">Calculadoras</a></li>
                    <li><a class="@(IsActive("/blog") ? "active" : "")" asp-page="/Blog/Index">Blog</a></li>
                    <li><a class="@(IsActive("/duvidas") ? "active" : "")" asp-page="/Duvidas/Index">Ajuda</a></li>
                    <li>
                        <a class="@(IsActive("/meu-painel") ? "active" : "")" asp-page="/MeuPainel/Index">
                            Meu painel
                            <span class="valora-nav-badge" data-local-panel-count hidden>0</span>
                        </a>
                    </li>
                </ul>
            </nav>
            <button class="valora-nav-toggle" type="button" aria-label="Abrir menu" aria-expanded="false" data-nav-toggle>
                <span class="material-symbols-outlined">menu</span>
            </button>
        </div>
        <div class="valora-container valora-nav-mobile" data-nav-mobile>
            <a asp-page="/Index">Início</a>
            <a asp-page="/Calculadoras/Index">Calculadoras</a>
            <a asp-page="/Blog/Index">Blog</a>
            <a asp-page="/Duvidas/Index">Ajuda</a>
            <a asp-page="/MeuPainel/Index">Meu painel</a>
            <a asp-page="/Contato">Contato</a>
        </div>
    </header>

    <div class="valora-page-shell">
        <main class="valora-main" role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="valora-footer valora-footer--stitch">
        <div class="valora-container valora-footer-inner">
            <partial name="Shared/_BrandMark" view-data='new ViewDataDictionary(ViewData) { { "BrandMarkClass", "valora-brand-mark--footer" } }' />
            <p class="valora-footer-tagline">Ferramenta educativa para cálculos trabalhistas e fiscais.</p>
            <div class="valora-footer-links">
                <a asp-page="/Sobre">Sobre</a>
                <a asp-page="/ComoCalculamos">Como calculamos</a>
                <a asp-page="/MapaDoSite">Mapa do site</a>
                <a asp-page="/PoliticaDePrivacidade">Privacidade</a>
                <a asp-page="/TermosDeUso">Termos</a>
                <a asp-page="/AvisoLegal">Aviso legal</a>
            </div>
            <p class="valora-footer-copy">&copy; @DateTime.UtcNow.Year Meu Valor Líquido. Resultados estimados para fins educativos.</p>
        </div>
    </footer>

    @if (!hideBottomNav)
    {
        <partial name="Shared/_BottomNav" />
    }

    <partial name="_CookieConsent" />

    <script src="~/js/product-metrics.js" asp-append-version="true" defer></script>
    <partial name="_AdSenseScript" />
    <script src="~/js/site.js" asp-append-version="true" defer></script>
    <script src="~/js/local-panel.js" asp-append-version="true" defer></script>
    @if (AdsOptions.Value.IsActive)
    {
        <script src="~/js/cookie-consent.js" asp-append-version="true" defer></script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
