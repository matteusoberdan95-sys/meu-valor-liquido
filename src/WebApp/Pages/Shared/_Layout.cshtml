@inject IConfiguration Configuration
@inject Microsoft.Extensions.Options.IOptions<MeuValorLiquido.Modules.Ads.AdsOptions> AdsOptions
@{
    var currentPath = Context.Request.Path.Value ?? "/";
    bool IsActive(string path) =>
        path == "/" ? currentPath == "/" : currentPath.StartsWith(path, StringComparison.OrdinalIgnoreCase);
    var hideBottomNav = ViewData["HideBottomNav"] as bool? == true;
    var hideAssistantLauncher = ViewData["HideAssistantLauncher"] as bool? == true;
    var deferMainCss = ViewData["DeferMainCss"] as bool? == true;
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @{
        var title = ViewData["Title"]?.ToString() ?? "Meu Valor Líquido";
        var description = ViewData["Description"]?.ToString() ?? "Calculadoras trabalhistas, fiscais e financeiras para brasileiros.";
        var baseUrl = Configuration["Site:BaseUrl"]?.TrimEnd('/') ?? $"{Context.Request.Scheme}://{Context.Request.Host}";
        var canonicalPath = ViewData["CanonicalPath"]?.ToString() ?? Context.Request.Path.Value ?? "/";
        var canonicalUrl = SeoMetadataHelper.BuildCanonicalUrl(baseUrl, canonicalPath);
        var ogType = ViewData["OgType"]?.ToString() ?? "website";
        var robots = ViewData["Robots"]?.ToString() ?? SeoMetadataHelper.DefaultRobots;
        var ogImagePath = ViewData["OgImagePath"]?.ToString();
        var ogImageUrl = SeoMetadataHelper.BuildOgImageUrl(baseUrl, ogImagePath);
    }
    <meta name="robots" content="@robots" />
    <meta name="description" content="@description" />
    <link rel="canonical" href="@canonicalUrl" />
    <meta property="og:title" content="@title" />
    <meta property="og:description" content="@description" />
    <meta property="og:type" content="@ogType" />
    <meta property="og:url" content="@canonicalUrl" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="@SeoMetadataHelper.SiteName" />
    <meta property="og:image" content="@ogImageUrl" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@title" />
    <meta name="twitter:description" content="@description" />
    <meta name="twitter:image" content="@ogImageUrl" />
    <title>@title - Meu Valor Líquido</title>
    <link rel="icon" href="~/favicon.ico" sizes="any" />
    <link rel="icon" href="~/images/brand/logo-icon.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="~/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    @if (deferMainCss)
    {
        <partial name="Shared/_HomeCriticalCss" />
        <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" media="(min-width: 992px)" />
        <link rel="stylesheet" href="~/MeuValorLiquido.WebApp.styles.css" asp-append-version="true" media="(min-width: 992px)" />
        <link rel="preload" href="~/css/site.css" asp-append-version="true" as="style" media="(max-width: 991.98px)" data-deferred-stylesheet />
        <link rel="preload" href="~/MeuValorLiquido.WebApp.styles.css" asp-append-version="true" as="style" media="(max-width: 991.98px)" data-deferred-stylesheet />
        <noscript>
            <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
            <link rel="stylesheet" href="~/MeuValorLiquido.WebApp.styles.css" asp-append-version="true" />
        </noscript>
    }
    else
    {
        <link rel="preload" href="~/css/site.css" asp-append-version="true" as="style" />
        <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/MeuValorLiquido.WebApp.styles.css" asp-append-version="true" />
    }
    @await RenderSectionAsync("Head", required: false)
</head>
<body class="valora-app@(hideBottomNav ? "" : " valora-has-bottom-nav")">
    <header class="valora-header valora-header--stitch">
        <div class="valora-container valora-header-inner">
            <partial name="Shared/_BrandMark" />
            <nav class="valora-nav-desktop" aria-label="Principal">
                <div class="valora-header-desktop">
                    <ul class="valora-nav">
                        <li><a class="@(currentPath == "/" ? "active" : "")" asp-page="/Index">Início</a></li>
                        <li><a class="@(IsActive("/calculadoras") ? "active" : "")" asp-page="/Calculadoras/Index">Calculadoras</a></li>
                        <li><a class="@(IsActive("/conferir-holerite") ? "active" : "")" asp-page="/ConferirHolerite/Index" data-testid="nav-conferir-holerite">Holerite</a></li>
                        <li><a class="@(IsActive("/desligamento") || IsActive("/negociar-salario") || IsActive("/virar-pj") ? "active" : "")" asp-page="/Index" asp-fragment="jornadas-tematicas" data-testid="nav-guias">Guias</a></li>
                        <li><a class="@(IsActive("/blog") ? "active" : "")" asp-page="/Blog/Index">Blog</a></li>
                        <li><a class="@(IsActive("/duvidas") ? "active" : "")" asp-page="/Duvidas/Index">Ajuda</a></li>
                        <li><a class="@(IsActive("/assistente") ? "active" : "")" asp-page="/Assistente/Index">Chat</a></li>
                        <li class="valora-nav-icon-item">
                            <a class="valora-nav-icon-link @(IsActive("/meu-painel") ? "active" : "")" asp-page="/MeuPainel/Index" aria-label="Meu painel" title="Meu painel">
                                <span class="material-symbols-outlined" aria-hidden="true">person</span>
                                <span class="valora-sr-only">Meu painel</span>
                            </a>
                        </li>
                    </ul>
                    <form class="valora-nav-search" method="get" asp-page="/Calculadoras/Index" role="search">
                        <span class="material-symbols-outlined" aria-hidden="true">search</span>
                        <input type="search"
                               name="q"
                               class="valora-nav-search-input"
                               placeholder="Buscar..."
                               aria-label="Buscar calculadoras" />
                    </form>
                </div>
            </nav>
            <button class="valora-nav-toggle" type="button" aria-label="Abrir menu" aria-expanded="false" data-nav-toggle>
                <span class="material-symbols-outlined">menu</span>
            </button>
        </div>
        <div class="valora-container valora-nav-mobile" data-nav-mobile>
            <a asp-page="/Index">Início</a>
            <a asp-page="/Calculadoras/Index">Calculadoras</a>
            <a asp-page="/ConferirHolerite/Index" data-testid="nav-mobile-conferir-holerite">Conferir holerite</a>
            <a asp-page="/Index" asp-fragment="jornadas-tematicas" data-testid="nav-mobile-guias">Guias</a>
            <a asp-page="/Blog/Index">Blog</a>
            <a asp-page="/Duvidas/Index">Ajuda</a>
            <a asp-page="/Assistente/Index">Assistente</a>
            <a asp-page="/MeuPainel/Index">Meu painel</a>
            <a asp-page="/Contato">Contato</a>
        </div>
    </header>

    <div class="valora-page-shell">
        <main class="valora-main" role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="valora-footer valora-footer--stitch">
        <div class="valora-container valora-footer-stitch">
            <div class="valora-footer-stitch-brand">
                <partial name="Shared/_BrandMark" view-data='new ViewDataDictionary(ViewData) { { "BrandMarkClass", "valora-brand-mark--footer" } }' />
                <p class="valora-footer-stitch-tagline">
                    &copy; @DateTime.UtcNow.Year Meu Valor Líquido. Educação financeira para brasileiros com ferramentas e fontes públicas.
                </p>
                <div class="valora-footer-stitch-social" aria-label="Links úteis">
                    <a class="valora-footer-stitch-social-btn" asp-page="/Contato" aria-label="Contato">
                        <span class="material-symbols-outlined" aria-hidden="true">share</span>
                    </a>
                    <a class="valora-footer-stitch-social-btn" asp-page="/Newsletter" aria-label="Newsletter">
                        <span class="material-symbols-outlined" aria-hidden="true">alternate_email</span>
                    </a>
                </div>
            </div>
            <div class="valora-footer-stitch-col">
                <p class="valora-footer-stitch-col-title">Calculadoras</p>
                <ul class="valora-footer-stitch-links">
                    <li><a asp-page="/Calculadoras/Details" asp-route-slug="salario-liquido">Salário líquido</a></li>
                    <li><a asp-page="/Calculadoras/Details" asp-route-slug="rescisao-clt">Rescisão trabalhista</a></li>
                    <li><a asp-page="/Calculadoras/Details" asp-route-slug="pj-vs-clt">CLT vs PJ</a></li>
                    <li><a asp-page="/Calculadoras/Details" asp-route-slug="decimo-terceiro">13º salário</a></li>
                    <li><a asp-page="/ConferirHolerite/Index" data-testid="footer-conferir-holerite">Conferir holerite</a></li>
                </ul>
            </div>
            <div class="valora-footer-stitch-col">
                <p class="valora-footer-stitch-col-title">Guias</p>
                <ul class="valora-footer-stitch-links">
                    <li><a href="/desligamento" data-testid="footer-hub-desligamento">Desligamento CLT</a></li>
                    <li><a href="/negociar-salario" data-testid="footer-hub-negociar-salario">Negociar salário</a></li>
                    <li><a href="/virar-pj" data-testid="footer-hub-virar-pj">Virar PJ</a></li>
                </ul>
            </div>
            <div class="valora-footer-stitch-col">
                <p class="valora-footer-stitch-col-title">Institucional</p>
                <ul class="valora-footer-stitch-links">
                    <li><a asp-page="/Sobre">Sobre nós</a></li>
                    <li><a asp-page="/ComoCalculamos">Metodologia</a></li>
                    <li><a asp-page="/PoliticaEditorial">Política Editorial</a></li>
                    <li><a href="@EditorialAuthorCatalog.Primary.ProfilePath">Responsável editorial</a></li>
                    <li><a asp-page="/Contato">Contato</a></li>
                    <li><a asp-page="/PoliticaDePrivacidade">Privacidade</a></li>
                    <li><a asp-page="/PoliticaDeCookies">Cookies</a></li>
                </ul>
            </div>
            <div class="valora-footer-stitch-col valora-footer-stitch-col--newsletter">
                <p class="valora-footer-stitch-col-title">Newsletter</p>
                <p class="valora-footer-stitch-newsletter-lead">Receba atualizações sobre tributação e finanças.</p>
                <partial name="Shared/_FooterStitchNewsletter" />
            </div>
            <p class="valora-footer-copy">Resultados estimados para fins educativos. Não substituem orientação profissional.</p>
            <p class="valora-footer-stitch-ribbon">Metodologia transparente · Fontes oficiais · Dados 2026</p>
        </div>
    </footer>

    @if (!hideBottomNav)
    {
        <partial name="Shared/_BottomNav" />
    }

    @if (!hideAssistantLauncher)
    {
        <partial name="Shared/_AssistantLauncher" />
    }

    <partial name="_CookieConsent" />

    <script src="~/js/product-metrics.js" asp-append-version="true" defer></script>
    <partial name="_AdSenseScript" />
    <script src="~/js/adsense-init.js" asp-append-version="true" defer></script>
    @if (deferMainCss)
    {
        <script src="~/js/css-loader.js" asp-append-version="true" defer></script>
    }
    <script src="~/js/font-loader.js" asp-append-version="true" defer></script>
    <script src="~/js/site.js" asp-append-version="true" defer></script>
    <script src="~/js/cookie-consent.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
