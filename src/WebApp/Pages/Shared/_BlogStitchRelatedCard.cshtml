@model MeuValorLiquido.Modules.Content.BlogPost
@{
    var visualClass = BlogHubHelper.GetVisualClass(Model.Category);
    var visualIcon = BlogHubHelper.GetVisualIcon(Model.Category, Model.Slug);
    var categoryClass = BlogContentHelper.GetCategoryTextClass(Model.Category);
}

<a class="valora-stitch-blog-related-card" asp-page="/Blog/Post" asp-route-slug="@Model.Slug">
    <div class="valora-stitch-blog-related-visual @visualClass" aria-hidden="true">
        <span class="valora-stitch-blog-related-badge @categoryClass">@BlogContentHelper.GetCategoryLabel(Model.Category)</span>
        <span class="material-symbols-outlined">@visualIcon</span>
    </div>
    <div class="valora-stitch-blog-related-body">
        <h3 class="valora-stitch-blog-related-title">@Model.Title</h3>
        <p class="valora-stitch-blog-related-summary">@Model.Summary</p>
    </div>
</a>
