@model MeuValorLiquido.Modules.Ads.AdSlotDefinition
@inject Microsoft.Extensions.Options.IOptions<MeuValorLiquido.Modules.Ads.AdsOptions> AdsOptions

<div class="ad-slot-wrap" role="complementary" aria-label="Espaço publicitário">
    <span class="ad-slot-label">Espaço publicitário</span>
    @if (AdsOptions.Value.IsActive && !Model.IsPlaceholder && !string.IsNullOrWhiteSpace(Model.AdSlotId))
    {
        <div class="ad-slot ad-slot--live">
            <ins class="adsbygoogle"
                 style="display:block"
                 data-ad-client="@AdsOptions.Value.PublisherId"
                 data-ad-slot="@Model.AdSlotId"
                 data-ad-format="auto"
                 data-full-width-responsive="true"></ins>
        </div>
    }
    else if (Model.IsEnabled)
    {
        <div class="ad-slot" aria-hidden="true">@Model.Label</div>
    }
</div>
