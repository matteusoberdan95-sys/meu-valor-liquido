@model IReadOnlyList<MeuValorLiquido.Modules.Calculators.FaqItem>
@using System.Text.Json

@if (Model.Count > 0)
{
    var schema = new Dictionary<string, object>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "FAQPage",
        ["mainEntity"] = Model.Select(f => new Dictionary<string, object>
        {
            ["@type"] = "Question",
            ["name"] = f.Question,
            ["acceptedAnswer"] = new Dictionary<string, object>
            {
                ["@type"] = "Answer",
                ["text"] = f.Answer
            }
        }).ToList()
    };
    <script type="application/ld+json">@Html.Raw(JsonSerializer.Serialize(schema))</script>
}
