<form method="post"
      asp-page="/Newsletter"
      class="valora-footer-stitch-newsletter-form"
      aria-label="Inscrever-se na newsletter">
    <label class="valora-sr-only" for="footer-newsletter-email">E-mail</label>
    <input id="footer-newsletter-email"
           name="Email"
           class="valora-footer-stitch-newsletter-input"
           type="email"
           placeholder="Seu e-mail"
           autocomplete="email"
           required />
    <button class="valora-footer-stitch-newsletter-btn" type="submit">OK</button>
</form>
