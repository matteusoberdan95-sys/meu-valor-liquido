@inject Microsoft.Extensions.Options.IOptions<MeuValorLiquido.Modules.Ads.AdsOptions> AdsOptions
@{
    var ads = AdsOptions.Value;
}
@if (ads.ShouldRenderVerificationScript)
{
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=@ads.PublisherId"
            crossorigin="anonymous"></script>
}
