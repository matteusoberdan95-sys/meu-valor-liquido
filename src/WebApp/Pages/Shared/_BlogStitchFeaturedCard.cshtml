@model MeuValorLiquido.Modules.Content.BlogPost
@{
    var readingMinutes = BlogContentHelper.EstimateReadingMinutes(Model.Content);
    var borderClass = BlogHubHelper.GetFeaturedBorderClass(Model.Category);
    var categoryClass = BlogContentHelper.GetCategoryTextClass(Model.Category);
    var heroModel = new BlogHeroVisualModel(
        Model.Slug,
        Model.Title,
        Model.Category,
        "valora-stitch-blog-featured-visual");
}

<a class="valora-stitch-blog-featured @borderClass"
   asp-page="/Blog/Post"
   asp-route-slug="@Model.Slug">
    <partial name="Shared/_BlogStitchHeroVisual" model="heroModel" />
    <div class="valora-stitch-blog-featured-body">
        <div class="valora-stitch-blog-featured-meta">
            <span class="valora-stitch-blog-cat-text @categoryClass">@BlogContentHelper.GetCategoryLabel(Model.Category)</span>
            <span class="valora-stitch-blog-meta-dot">@readingMinutes min de leitura</span>
        </div>
        <h2 class="valora-stitch-blog-featured-title">@Model.Title</h2>
        <p class="valora-stitch-blog-featured-summary">@Model.Summary</p>
        <span class="valora-stitch-blog-featured-cta">
            Ler artigo completo
            <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
        </span>
    </div>
</a>
