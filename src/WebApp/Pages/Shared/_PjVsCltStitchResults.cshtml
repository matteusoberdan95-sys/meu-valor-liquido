@model MeuValorLiquido.WebApp.Infrastructure.PjVsCltStitchResultsViewModel
@{
    var b = Model.Breakdown;
    var display = PjVsCltStitchDisplayBuilder.Build(b);
    var verdictClass = display.PjWins ? "valora-stitch-cltpj-verdict--pj" : display.CltWins ? "valora-stitch-cltpj-verdict--clt" : "valora-stitch-cltpj-verdict--tie";
    var verdictBadge = display.PjWins ? "Melhor opção: PJ" : display.CltWins ? "Melhor opção: CLT" : "Cenários equivalentes";
    var verdictTitle = display.PjWins
        ? $"Veredito: ser PJ é +{display.AdvantagePercent}% vantajoso"
        : display.CltWins
            ? $"Veredito: CLT é +{display.AdvantagePercent}% vantajoso"
            : "Veredito: cenários equivalentes";
    var verdictIcon = display.PjWins ? "trending_up" : display.CltWins ? "work" : "balance";
    var diffAbs = Math.Abs(b.NetDifference);
}

<div class="valora-stitch-cltpj-results valora-stack-md" aria-live="polite">
    <partial name="Shared/_CalculatorResultWarnings" model="Model.Warnings" />

    <div class="valora-stitch-cltpj-verdict @verdictClass valora-stitch-cltpj-verdict--hero">
        <div class="valora-stitch-cltpj-verdict-hero-badge">
            <span class="material-symbols-outlined valora-icon-filled" aria-hidden="true">stars</span>
            @verdictBadge
        </div>
        <div class="valora-stitch-cltpj-verdict-top">
            <div>
                <h2 class="valora-stitch-cltpj-verdict-title">@verdictTitle</h2>
                <p class="valora-stitch-cltpj-verdict-lead">
                    Considerando impostos, benefícios e custos operacionais, o regime
                    @(display.PjWins ? "PJ" : display.CltWins ? "CLT" : "escolhido")
                    oferece maior retorno líquido estimado no seu cenário.
                </p>
            </div>
            <span class="material-symbols-outlined valora-stitch-cltpj-verdict-icon" aria-hidden="true">@verdictIcon</span>
        </div>

        <div class="valora-stitch-cltpj-annual-compare">
            <div class="valora-stitch-cltpj-annual-col">
                <p class="valora-stitch-cltpj-annual-label">Líquido anual PJ</p>
                <p class="valora-stitch-cltpj-annual-value valora-stitch-cltpj-annual-value--pj">@Money.From(display.PjAnnualNet)</p>
                <div class="valora-stitch-cltpj-annual-bar" aria-hidden="true">
                    <span class="valora-stitch-cltpj-annual-bar-fill valora-stitch-cltpj-annual-bar-fill--pj" style="width: @(display.PjBarPercent)%"></span>
                </div>
            </div>
            <div class="valora-stitch-cltpj-annual-col">
                <p class="valora-stitch-cltpj-annual-label">Líquido anual CLT</p>
                <p class="valora-stitch-cltpj-annual-value">@Money.From(display.CltAnnualNet)</p>
                <div class="valora-stitch-cltpj-annual-bar" aria-hidden="true">
                    <span class="valora-stitch-cltpj-annual-bar-fill" style="width: @(display.CltBarPercent)%"></span>
                </div>
            </div>
        </div>

        <div class="valora-stitch-cltpj-verdict-diff">
            <p class="valora-stitch-cltpj-verdict-diff-label">Diferença real mensal</p>
            <p class="valora-stitch-cltpj-verdict-diff-value">@Money.From(diffAbs)</p>
        </div>
    </div>

    <div class="valora-stitch-cltpj-detail-grid">
        <section class="valora-stitch-cltpj-detail-card">
            <h3 class="valora-stitch-cltpj-detail-title">Detalhamento CLT</h3>
            <ul class="valora-stitch-cltpj-detail-list">
                <li><span>Bruto anual (inc. 13º/férias)</span><strong>@Money.From(display.CltAnnualGross)</strong></li>
                <li class="valora-stitch-cltpj-detail-list--debit"><span>IRRF + INSS</span><strong>- @Money.From(display.CltTaxesAnnual)</strong></li>
                <li class="valora-stitch-cltpj-detail-list--credit"><span>FGTS (reservas)</span><strong>+ @Money.From(display.CltFgtsAnnual)</strong></li>
                <li class="valora-stitch-cltpj-detail-list--total"><span>Líquido final</span><strong>@Money.From(display.CltAnnualNet)</strong></li>
            </ul>
        </section>
        <section class="valora-stitch-cltpj-detail-card">
            <h3 class="valora-stitch-cltpj-detail-title">Detalhamento PJ</h3>
            <ul class="valora-stitch-cltpj-detail-list">
                <li><span>Faturamento bruto anual</span><strong>@Money.From(display.PjRevenueAnnual)</strong></li>
                <li class="valora-stitch-cltpj-detail-list--debit"><span>Impostos (Simples @b.SimplesRatePercent.ToString("0.#")%)</span><strong>- @Money.From(display.PjTaxesAnnual)</strong></li>
                <li class="valora-stitch-cltpj-detail-list--debit"><span>Custos (contador/encargos)</span><strong>- @Money.From(display.PjCostsAnnual)</strong></li>
                <li class="valora-stitch-cltpj-detail-list--total valora-stitch-cltpj-detail-list--pj"><span>Líquido final</span><strong>@Money.From(display.PjAnnualNet)</strong></li>
            </ul>
        </section>
    </div>

    <div class="valora-stitch-cltpj-compare-grid">
        <div class="valora-stitch-cltpj-compare-card valora-stitch-cltpj-compare-card--clt">
            <p class="valora-stitch-cltpj-compare-label">Líquido CLT (mês)</p>
            <p class="valora-stitch-cltpj-compare-value">@Money.From(b.Clt.Net)</p>
        </div>
        <div class="valora-stitch-cltpj-compare-card valora-stitch-cltpj-compare-card--pj">
            <p class="valora-stitch-cltpj-compare-label">Líquido PJ (mês)</p>
            <p class="valora-stitch-cltpj-compare-value">@Money.From(b.Pj.Net)</p>
        </div>
    </div>

    @if (Model.Share is not null)
    {
        <div class="valora-stitch-cltpj-actions">
            @if (!string.IsNullOrEmpty(Model.Share.PdfUrl))
            {
                <a class="valora-stitch-cltpj-action-btn" href="@Model.Share.PdfUrl" download>
                    <span class="material-symbols-outlined" aria-hidden="true">picture_as_pdf</span>
                    Exportar relatório PDF
                </a>
            }
            <button type="button" class="valora-stitch-cltpj-action-btn" data-share-copy="link">
                <span class="material-symbols-outlined" aria-hidden="true">share</span>
                Compartilhar
            </button>
        </div>
        <textarea id="calculator-share-url" hidden readonly>@Model.Share.ShareUrl</textarea>
        <textarea id="calculator-share-text" hidden readonly>@Model.Share.ShareText</textarea>
        <p class="valora-text-muted valora-text-sm valora-share-feedback" data-share-feedback hidden aria-live="polite"></p>
    }

    <details class="valora-stitch-cltpj-accordion">
        <summary>
            <span>Resumo de tributos (mensal)</span>
            <span class="material-symbols-outlined">expand_more</span>
        </summary>
        <div class="valora-stitch-cltpj-accordion-body">
            <div class="valora-stitch-cltpj-tax-line">
                <span>INSS (CLT)</span>
                <strong>@Money.From(b.Clt.Inss)</strong>
            </div>
            <div class="valora-stitch-cltpj-tax-line">
                <span>IRRF (CLT)</span>
                <strong>@Money.From(b.Clt.Irrf)</strong>
            </div>
            <div class="valora-stitch-cltpj-tax-line valora-stitch-cltpj-tax-line--total">
                <span>Simples (@b.SimplesRatePercent.ToString("0.#")%) + encargos PJ</span>
                <strong>@Money.From(b.Pj.SimplesTax + b.Pj.Inss + b.Pj.Irrf)</strong>
            </div>
        </div>
    </details>

    <details class="valora-stitch-cltpj-accordion">
        <summary>
            <span>Benefícios ocultos CLT</span>
            <span class="material-symbols-outlined">expand_more</span>
        </summary>
        <div class="valora-stitch-cltpj-accordion-body">
            <div class="valora-stitch-cltpj-tax-line">
                <span>FGTS (8%/mês)</span>
                <strong>@Money.From(b.Clt.HiddenBenefits.FgtsMonthly)</strong>
            </div>
            <div class="valora-stitch-cltpj-tax-line">
                <span>Provisão 13º</span>
                <strong>@Money.From(b.Clt.HiddenBenefits.ThirteenthProvision)</strong>
            </div>
            <div class="valora-stitch-cltpj-tax-line">
                <span>Provisão férias + 1/3</span>
                <strong>@Money.From(b.Clt.HiddenBenefits.VacationProvision)</strong>
            </div>
            <div class="valora-stitch-cltpj-tax-line valora-stitch-cltpj-tax-line--total">
                <span>Total mensal (educativo)</span>
                <strong>@Money.From(b.Clt.HiddenBenefits.TotalMonthly)</strong>
            </div>
        </div>
    </details>
</div>
