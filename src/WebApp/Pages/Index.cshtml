@page
@model IndexModel
@inject IConfiguration Configuration
@using System.Text.Json
@{
    ViewData["Title"] = "Calculadoras trabalhistas, fiscais e financeiras";
    ViewData["Description"] = "Entenda quanto você realmente recebe, quanto desconta e quanto sobra com calculadoras simples para brasileiros.";
    ViewData["CanonicalPath"] = "/";
    var baseUrl = Configuration["Site:BaseUrl"]?.TrimEnd('/') ?? "https://meuvalorliquido.com.br";
    var webSiteSchema = new Dictionary<string, object>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "WebSite",
        ["name"] = "Meu Valor Líquido",
        ["url"] = baseUrl,
        ["description"] = ViewData["Description"]!,
        ["inLanguage"] = "pt-BR"
    };
}

@section Head {
    <script type="application/ld+json">@Html.Raw(JsonSerializer.Serialize(webSiteSchema))</script>
}

<section class="valora-hero valora-section">
    <h1 class="valora-h1">Entenda quanto você realmente recebe</h1>
    <p class="valora-lead">Calculadoras trabalhistas, fiscais e financeiras com resultado em formato de extrato, explicação simples e aviso legal.</p>
    <div class="valora-gap-buttons" style="margin-top: 2rem;">
        <a class="valora-btn valora-btn-primary" asp-page="/Calculadoras/Index">Ver calculadoras</a>
        <a class="valora-btn valora-btn-outline" asp-page="/Calculadoras/Details" asp-route-slug="proposta-salarial">Comparar proposta salarial</a>
        <a class="valora-btn valora-btn-outline" asp-page="/Blog/Index">Ler o blog</a>
    </div>
    <div class="valora-trust-row">
        <span class="valora-trust-item"><span class="material-symbols-outlined">verified</span> Gratuito</span>
        <span class="valora-trust-item"><span class="material-symbols-outlined">smartphone</span> Mobile-first</span>
        <span class="valora-trust-item"><span class="material-symbols-outlined">calendar_today</span> Tabelas 2026</span>
        <span class="valora-trust-item"><span class="material-symbols-outlined">school</span> Estimativa educativa</span>
    </div>
</section>

<section class="valora-section">
    <h2 class="valora-h2">Calculadoras populares</h2>
    <p class="valora-text-muted valora-text-sm" style="margin-bottom: 1.5rem;">As mais usadas para entender descontos e valor líquido.</p>
    <div class="valora-card-grid">
        @foreach (var calculator in Model.Calculators.Take(6))
        {
            <article class="valora-card">
                <a class="valora-calc-card" asp-page="/Calculadoras/Details" asp-route-slug="@calculator.Slug">
                    <div class="valora-calc-card-icon">
                        <span class="material-symbols-outlined">@CalculatorUiHelper.GetIcon(calculator.Slug)</span>
                    </div>
                    <partial name="Shared/_CalculatorCategoryBadge" model="calculator.Category" />
                    <h3 class="valora-h3" style="margin-top: 0.75rem;">@calculator.Name</h3>
                    <p class="valora-text-muted valora-text-sm" style="flex: 1;">@calculator.Summary</p>
                    <div class="valora-calc-card-footer">
                        Calcular
                        <span class="material-symbols-outlined" style="font-size: 1.125rem;">arrow_forward</span>
                    </div>
                </a>
            </article>
        }
    </div>
    @if (Model.Calculators.Count > 6)
    {
        <p style="margin-top: 1.5rem; text-align: center;">
            <a class="valora-btn valora-btn-outline" asp-page="/Calculadoras/Index">Ver todas as @Model.Calculators.Count calculadoras</a>
        </p>
    }
</section>

@if (Model.RecentPosts.Count > 0)
{
    <section class="valora-section">
        <h2 class="valora-h2">Últimos artigos</h2>
        <p class="valora-text-muted valora-text-sm" style="margin-bottom: 1.5rem;">Conteúdos educativos sobre salário, impostos e finanças.</p>
        @foreach (var post in Model.RecentPosts)
        {
            <partial name="Shared/_BlogPostCard" model="post" />
        }
        <p style="margin-top: 1rem; text-align: center;">
            <a class="valora-btn valora-btn-outline" asp-page="/Blog/Index">Ver todos os artigos</a>
        </p>
    </section>
}
