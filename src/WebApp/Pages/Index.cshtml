@page
@model IndexModel
@inject IConfiguration Configuration
@using System.Text.Json
@{
    ViewData["Title"] = "Calculadoras trabalhistas, fiscais e financeiras";
    ViewData["Description"] = "Entenda quanto você realmente recebe, quanto desconta e quanto sobra com calculadoras simples para brasileiros.";
    ViewData["CanonicalPath"] = "/";
    ViewData["BottomNavTab"] = "home";
    var baseUrl = Configuration["Site:BaseUrl"]?.TrimEnd('/') ?? "https://meuvalorliquido.com.br";
    var featuredSlugs = new[] { "salario-liquido", "pj-vs-clt", "simulador-mei", "ferias" };
    var featured = featuredSlugs
        .Select(slug => Model.Calculators.FirstOrDefault(c => c.Slug.Equals(slug, StringComparison.OrdinalIgnoreCase)))
        .Where(c => c is not null)
        .Cast<CalculatorDefinition>()
        .ToList();
    if (featured.Count < 4)
    {
        featured = Model.Calculators.Take(4).ToList();
    }
    var webSiteSchema = new Dictionary<string, object>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "WebSite",
        ["name"] = "Meu Valor Líquido",
        ["url"] = baseUrl,
        ["description"] = ViewData["Description"]!,
        ["inLanguage"] = "pt-BR"
    };
}

@section Head {
    <script type="application/ld+json">@Html.Raw(JsonSerializer.Serialize(webSiteSchema))</script>
}

<div class="valora-stitch-home">
    <section class="valora-stitch-hero valora-stitch-hero--split">
        <div class="valora-stitch-hero-content">
            <div class="valora-stitch-hero-mobile">
                <span class="valora-stitch-pill">
                    <span class="valora-stitch-pill-dot" aria-hidden="true"></span>
                    Educação Financeira
                </span>
                <h1 class="valora-stitch-hero-title">
                    Domine sua <span class="valora-text-glow">Liberdade</span> Financeira.
                </h1>
                <p class="valora-stitch-hero-lead">
                    Calculadoras precisas e insights profundos para quem busca clareza nos números.
                </p>
                <div class="valora-stitch-hero-actions valora-stitch-hero-actions--mobile">
                    <a class="valora-stitch-btn valora-stitch-btn--primary" asp-page="/Calculadoras/Details" asp-route-slug="salario-liquido">
                        Começar Cálculo
                        <span class="material-symbols-outlined" aria-hidden="true">trending_up</span>
                    </a>
                </div>
            </div>
            <div class="valora-stitch-hero-desktop">
                <span class="valora-stitch-pill valora-stitch-pill--desktop">Simulador 2026 atualizado</span>
                <h1 class="valora-stitch-hero-title">
                    Entenda quanto você recebe, quanto <span class="valora-text-glow">desconta</span> e quanto sobra.
                </h1>
                <p class="valora-stitch-hero-lead">
                    Simplificamos a complexidade tributária brasileira com cálculos precisos e ferramentas intuitivas para sua vida financeira.
                </p>
                <div class="valora-stitch-hero-actions">
                    <a class="valora-stitch-btn valora-stitch-btn--primary" asp-page="/Calculadoras/Details" asp-route-slug="salario-liquido">
                        <span class="material-symbols-outlined" aria-hidden="true">calculate</span>
                        Calcular Salário Líquido
                    </a>
                    <a class="valora-stitch-btn valora-stitch-btn--outline" asp-page="/Calculadoras/Index">
                        Ver todas as calculadoras
                    </a>
                </div>
                <div class="valora-stitch-trust-row">
                    <span><span class="material-symbols-outlined" aria-hidden="true">verified</span> Gratuito</span>
                    <span><span class="material-symbols-outlined" aria-hidden="true">smartphone</span> Mobile-first</span>
                    <span><span class="material-symbols-outlined" aria-hidden="true">school</span> Educativo</span>
                </div>
            </div>
        </div>
        <div class="valora-stitch-hero-visual-wrap" aria-hidden="true">
            <img class="valora-stitch-hero-visual"
                 src="~/images/hero/home-hero.webp"
                 alt=""
                 width="1200"
                 height="675"
                 loading="eager"
                 decoding="async" />
        </div>
    </section>

    <section class="valora-stitch-section">
        <div class="valora-stitch-section-head">
            <h2 class="valora-stitch-section-title">
                <span class="valora-stitch-section-title-mobile">Top Cálculos</span>
                <span class="valora-stitch-section-title-desktop">Principais Calculadoras</span>
            </h2>
            <a class="valora-stitch-link" asp-page="/Calculadoras/Index">Ver todas</a>
        </div>
        <div class="valora-stitch-bento">
            @foreach (var calculator in featured)
            {
                <a class="valora-stitch-bento-card @CalculatorUiHelper.GetBentoAccentClass(calculator.Category, calculator.Slug)"
                   asp-page="/Calculadoras/Details" asp-route-slug="@calculator.Slug">
                    <div class="valora-bento-icon-box @CalculatorUiHelper.GetBentoIconBoxClass(calculator.Category, calculator.Slug)">
                        <span class="material-symbols-outlined valora-stitch-bento-icon" aria-hidden="true">@CalculatorUiHelper.GetIcon(calculator.Slug)</span>
                    </div>
                    <h3 class="valora-stitch-bento-title">@calculator.Name</h3>
                    <p class="valora-stitch-bento-category">@calculator.Category</p>
                </a>
            }
        </div>
    </section>

    <div class="valora-stitch-ad-slot" role="complementary" aria-label="Espaço publicitário">
        <span class="valora-stitch-ad-label">Espaço publicitário</span>
        <p class="valora-stitch-ad-text">Publicidade</p>
    </div>

    <section class="valora-stitch-teaser">
        <div class="valora-stitch-teaser-content">
            <h2 class="valora-stitch-teaser-title">Relatórios completos</h2>
            <p class="valora-stitch-teaser-text">Veja o detalhamento de INSS, FGTS e IRRF em gráficos intuitivos.</p>
            <a class="valora-stitch-teaser-btn" asp-page="/MeuPainel/Index">Conhecer painel</a>
        </div>
        <div class="valora-stitch-teaser-decoration" aria-hidden="true"></div>
    </section>

    @if (Model.RecentPosts.Count > 0)
    {
        <section class="valora-stitch-section valora-stitch-section--articles">
            <div class="valora-stitch-section-head">
                <h2 class="valora-stitch-section-title">Últimas do Blog</h2>
                <a class="valora-stitch-link" asp-page="/Blog/Index">Ver blog</a>
            </div>
            <div class="valora-stitch-home-blog-feed">
                @foreach (var post in Model.RecentPosts.Take(3))
                {
                    <partial name="Shared/_HomeStitchBlogCard" model="post" />
                }
            </div>
        </section>
    }

    <div class="valora-stitch-disclaimer">
        <p>
            <strong>Aviso:</strong> Esta é uma ferramenta educativa. Os valores são estimativas baseadas na legislação vigente e não substituem o parecer de um contador profissional.
        </p>
    </div>
</div>
