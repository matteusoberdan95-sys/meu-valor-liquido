@page
@model IndexModel
@inject IConfiguration Configuration
@using System.Text.Json
@{
    ViewData["Title"] = "Calculadoras trabalhistas, fiscais e financeiras";
    ViewData["Description"] = "Entenda quanto você realmente recebe, quanto desconta e quanto sobra com calculadoras simples para brasileiros.";
    ViewData["CanonicalPath"] = "/";
    ViewData["BottomNavTab"] = "home";
    ViewData["DeferMainCss"] = true;
    var baseUrl = Configuration["Site:BaseUrl"]?.TrimEnd('/') ?? "https://meuvalorliquido.com.br";
    var featuredSlugs = new[] { "salario-liquido", "pj-vs-clt", "simulador-mei", "ferias" };
    var featured = featuredSlugs
        .Select(slug => Model.Calculators.FirstOrDefault(c => c.Slug.Equals(slug, StringComparison.OrdinalIgnoreCase)))
        .Where(c => c is not null)
        .Cast<CalculatorDefinition>()
        .ToList();
    if (featured.Count < 4)
    {
        featured = Model.Calculators.Take(4).ToList();
    }
    var desktopHubSlugs = new[] { "salario-liquido", "rescisao-clt", "pj-vs-clt", "decimo-terceiro", "financiamento" };
    var desktopHub = desktopHubSlugs
        .Select(slug => Model.Calculators.FirstOrDefault(c => c.Slug.Equals(slug, StringComparison.OrdinalIgnoreCase)))
        .Where(c => c is not null)
        .Cast<CalculatorDefinition>()
        .ToList();
    var featuredDesktop = desktopHub.FirstOrDefault();
    var secondaryDesktop = desktopHub.Skip(1).ToList();
    var webSiteSchema = new Dictionary<string, object>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "WebSite",
        ["name"] = "Meu Valor Líquido",
        ["url"] = baseUrl,
        ["description"] = ViewData["Description"]!,
        ["inLanguage"] = "pt-BR"
    };
}

@section Head {
    <link rel="preload" as="image" href="~/images/hero/home-hero.webp" asp-append-version="true" fetchpriority="high" media="(min-width: 992px)" />
    <script type="application/ld+json">@Html.Raw(JsonSerializer.Serialize(webSiteSchema))</script>
}

<div class="valora-stitch-home">
    <div class="valora-stitch-home-stage">
        <div class="valora-stitch-home-hero-backdrop" aria-hidden="true">
            <img class="valora-stitch-hero-visual"
                 src="~/images/hero/home-hero.webp"
                 asp-append-version="true"
                 alt=""
                 width="1200"
                 height="675"
                 loading="lazy"
                 decoding="async" />
        </div>

        <section class="valora-stitch-hero valora-stitch-hero--split">
            <div class="valora-stitch-hero-content">
            <div class="valora-stitch-hero-mobile">
                <span class="valora-stitch-pill">
                    <span class="valora-stitch-pill-dot" aria-hidden="true"></span>
                    Educação Financeira
                </span>
                <h1 class="valora-stitch-hero-title">
                    Domine sua <span class="valora-text-glow">Liberdade</span> Financeira.
                </h1>
                <p class="valora-stitch-hero-lead">
                    Calculadoras gratuitas e atualizadas para 2026, com premissas e fontes descritas na metodologia.
                </p>
                <div class="valora-stitch-hero-actions valora-stitch-hero-actions--mobile">
                    <a class="valora-stitch-btn valora-stitch-btn--primary" asp-page="/Calculadoras/Details" asp-route-slug="salario-liquido">
                        Começar Cálculo
                        <span class="material-symbols-outlined" aria-hidden="true">trending_up</span>
                    </a>
                </div>
            </div>
            <div class="valora-stitch-hero-desktop">
                <span class="valora-stitch-pill valora-stitch-pill--desktop">Simulador 2026 atualizado</span>
                <h1 class="valora-stitch-hero-title">
                    Entenda quanto você recebe, quanto <span class="valora-text-glow">desconta</span> e quanto sobra.
                </h1>
                <p class="valora-stitch-hero-lead">
                    Faça estimativas baseadas nas tabelas oficiais indicadas na metodologia e entenda cada etapa do cálculo.
                </p>
                <div class="valora-stitch-hero-actions">
                    <a class="valora-stitch-btn valora-stitch-btn--primary" asp-page="/Calculadoras/Details" asp-route-slug="salario-liquido">
                        <span class="material-symbols-outlined" aria-hidden="true">calculate</span>
                        Calcular Salário Líquido
                    </a>
                    <a class="valora-stitch-btn valora-stitch-btn--outline" asp-page="/Calculadoras/Index">
                        Ver todas as calculadoras
                    </a>
                </div>
                <p class="valora-text-muted valora-text-sm">Resultados educativos com metodologia, fontes e limitações públicas.</p>
            </div>
        </div>
        </section>

        <section class="valora-stitch-section valora-stitch-section--desktop-bento">
            <div class="valora-stitch-section-head valora-stitch-section-head--desktop-hub">
                <div>
                    <span class="valora-stitch-section-kicker">Calculadoras em destaque</span>
                    <h2 class="valora-stitch-section-title">Principais Calculadoras</h2>
                </div>
                <a class="valora-stitch-link valora-stitch-link--desktop-hub" asp-page="/Calculadoras/Index">
                    Explorar catálogo completo
                    <span class="material-symbols-outlined" aria-hidden="true">trending_flat</span>
                </a>
            </div>
            <div class="valora-stitch-home-desktop-bento">
                @if (featuredDesktop is not null)
                {
                    <a class="valora-stitch-home-featured-card" asp-page="/Calculadoras/Details" asp-route-slug="@featuredDesktop.Slug">
                        <div class="valora-stitch-home-featured-head">
                            <div class="valora-bento-icon-box valora-bento-icon-box--financeiro valora-stitch-home-featured-icon">
                                <span class="material-symbols-outlined" aria-hidden="true">@CalculatorUiHelper.GetIcon(featuredDesktop.Slug)</span>
                            </div>
                        </div>
                        <h3 class="valora-stitch-home-featured-title">@featuredDesktop.Name</h3>
                        <p class="valora-stitch-home-featured-summary">@CalculatorUiHelper.GetHomeDesktopCardSummary(featuredDesktop.Slug)</p>
                        <div class="valora-stitch-home-featured-cta">
                            <span>Simular agora</span>
                            <span class="valora-stitch-home-featured-line" aria-hidden="true"></span>
                            <span class="material-symbols-outlined" aria-hidden="true">arrow_forward_ios</span>
                        </div>
                    </a>
                }
                @foreach (var calculator in secondaryDesktop)
                {
                    <a class="valora-stitch-home-hub-card @CalculatorUiHelper.GetBentoAccentClass(calculator.Category, calculator.Slug)"
                       asp-page="/Calculadoras/Details" asp-route-slug="@calculator.Slug">
                        <div class="valora-bento-icon-box @CalculatorUiHelper.GetBentoIconBoxClass(calculator.Category, calculator.Slug)">
                            <span class="material-symbols-outlined" aria-hidden="true">@CalculatorUiHelper.GetIcon(calculator.Slug)</span>
                        </div>
                        <h3 class="valora-stitch-home-hub-card-title">@calculator.Name</h3>
                        <p class="valora-stitch-home-hub-card-summary">@CalculatorUiHelper.GetHomeDesktopCardSummary(calculator.Slug)</p>
                        <span class="material-symbols-outlined valora-stitch-home-hub-card-arrow" aria-hidden="true">open_in_new</span>
                    </a>
                }
            </div>
        </section>
    </div>

    <section class="valora-stitch-section valora-stitch-section--mobile-bento">
        <div class="valora-stitch-section-head">
            <h2 class="valora-stitch-section-title">Top Cálculos</h2>
            <a class="valora-stitch-link" asp-page="/Calculadoras/Index">Ver todos</a>
        </div>
        <div class="valora-stitch-bento">
            @foreach (var calculator in featured)
            {
                <a class="valora-stitch-bento-card @CalculatorUiHelper.GetBentoAccentClass(calculator.Category, calculator.Slug)"
                   asp-page="/Calculadoras/Details" asp-route-slug="@calculator.Slug">
                    <div class="valora-bento-icon-box @CalculatorUiHelper.GetBentoIconBoxClass(calculator.Category, calculator.Slug)">
                        <span class="material-symbols-outlined valora-stitch-bento-icon" aria-hidden="true">@CalculatorUiHelper.GetIcon(calculator.Slug)</span>
                    </div>
                    <h3 class="valora-stitch-bento-title">@calculator.Name</h3>
                    <p class="valora-stitch-bento-category">@CalculatorUiHelper.GetBentoSubtitle(calculator.Slug, calculator.Category)</p>
                </a>
            }
        </div>
    </section>

    <partial name="Shared/_ThematicJourneyCards" />

    <partial name="Shared/_UtilityToolsCards" />

    @inject ICalculatorCatalogService WhatIfCalculatorCatalog
    <partial name="Shared/_WhatIfScenarioCards" model="WhatIfScenarioCardBuilder.BuildForHub(null, WhatIfCalculatorCatalog)" />

    @if (Model.RecentPosts.Count > 0)
    {
        <section class="valora-stitch-section valora-stitch-section--articles">
            <div class="valora-stitch-section-head valora-stitch-section-head--blog">
                <div>
                    <span class="valora-stitch-section-kicker valora-stitch-section-kicker--center-desktop">Educação Financeira</span>
                    <h2 class="valora-stitch-section-title">Últimas do Blog</h2>
                </div>
                <a class="valora-stitch-link valora-stitch-link--desktop-only" asp-page="/Blog/Index">Ver blog</a>
            </div>
            <div class="valora-stitch-home-blog-feed">
                @foreach (var post in Model.RecentPosts.Take(3))
                {
                    <partial name="Shared/_HomeStitchBlogCard" model="post" />
                }
            </div>
        </section>
    }

    <section class="valora-stitch-home-methodology" aria-labelledby="home-methodology-title">
        <div class="valora-stitch-home-methodology-card">
            <div class="valora-stitch-home-methodology-accent" aria-hidden="true"></div>
            <h2 id="home-methodology-title" class="valora-stitch-home-methodology-title">Nossa Metodologia</h2>
            <p>
                No <strong>Meu Valor Líquido</strong>, nossa missão é facilitar o acesso à educação financeira.
                As estimativas usam as regras e tabelas oficiais indicadas na página de metodologia.
            </p>
            <p>
                Cada cálculo considera alíquotas progressivas, deduções por dependentes e benefícios previdenciários,
                para você enxergar o poder de compra real do seu salário.
            </p>
            <a class="valora-stitch-link" asp-page="/ComoCalculamos">Ver metodologia completa</a>
        </div>
        <div class="valora-stitch-home-methodology-features">
            <article>
                <span class="material-symbols-outlined" aria-hidden="true">verified_user</span>
                <div>
                    <h3>Dados atualizados</h3>
                    <p>Tabelas tributárias de 2026 e cenários de benchmark documentados.</p>
                </div>
            </article>
            <article>
                <span class="material-symbols-outlined" aria-hidden="true">privacy_tip</span>
                <div>
                    <h3>Privacidade total</h3>
                    <p>Simulações salvas ficam no seu navegador — sem login obrigatório para calcular.</p>
                </div>
            </article>
            <article>
                <span class="material-symbols-outlined" aria-hidden="true">engineering</span>
                <div>
                    <h3>Suporte técnico</h3>
                    <p>Rotina de calibração e revisão mensal documentada em <a asp-page="/ComoCalculamos">Como calculamos</a>.</p>
                </div>
            </article>
        </div>
    </section>

    <div class="valora-stitch-disclaimer">
        <p>
            <strong>Aviso:</strong> Esta é uma ferramenta educativa. Os valores são estimativas baseadas na legislação vigente e não substituem o parecer de um contador profissional.
        </p>
    </div>
</div>
