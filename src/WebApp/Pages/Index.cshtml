@page
@model IndexModel
@inject IConfiguration Configuration
@using System.Text.Json
@{
    ViewData["Title"] = "Calculadoras trabalhistas, fiscais e financeiras";
    ViewData["Description"] = "Entenda quanto você realmente recebe, quanto desconta e quanto sobra com calculadoras simples para brasileiros.";
    ViewData["CanonicalPath"] = "/";
    var baseUrl = Configuration["Site:BaseUrl"]?.TrimEnd('/') ?? "https://meuvalorliquido.com.br";
    var webSiteSchema = new Dictionary<string, object>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "WebSite",
        ["name"] = "Meu Valor Líquido",
        ["url"] = baseUrl,
        ["description"] = ViewData["Description"]!,
        ["inLanguage"] = "pt-BR"
    };
}

@section Head {
    <script type="application/ld+json">@Html.Raw(JsonSerializer.Serialize(webSiteSchema))</script>
}

<section class="mvl-hero">
    <h1>Entenda quanto você realmente recebe</h1>
    <p class="lead mb-3">Calculadoras trabalhistas, fiscais e financeiras com resultado em formato de extrato, explicação simples e aviso legal.</p>
    <a class="btn btn-primary mvl-btn-primary" asp-page="/Calculadoras/Index">Ver calculadoras</a>
    <div class="mvl-trust-badges">
        <span class="mvl-badge-trust">Gratuito</span>
        <span class="mvl-badge-trust">Mobile-first</span>
        <span class="mvl-badge-trust">Tabelas 2026</span>
        <span class="mvl-badge-trust">Estimativa educativa</span>
    </div>
</section>

<section>
    <h2 class="h4 mb-3">Calculadoras populares</h2>
    <div class="row g-3">
        @foreach (var calculator in Model.Calculators.Take(6))
        {
            <article class="col-md-6 col-lg-4">
                <div class="card mvl-card-calculator">
                    <div class="card-body d-flex flex-column">
                        <partial name="Shared/_CalculatorCategoryBadge" model="calculator.Category" />
                        <h3 class="h5 mt-2">@calculator.Name</h3>
                        <p class="text-muted flex-grow-1">@calculator.Summary</p>
                        <a class="btn btn-outline-primary mt-2 align-self-start" asp-page="/Calculadoras/Details" asp-route-slug="@calculator.Slug">Calcular</a>
                    </div>
                </div>
            </article>
        }
    </div>
    @if (Model.Calculators.Count > 6)
    {
        <p class="mt-3"><a asp-page="/Calculadoras/Index">Ver todas as @Model.Calculators.Count calculadoras</a></p>
    }
</section>
